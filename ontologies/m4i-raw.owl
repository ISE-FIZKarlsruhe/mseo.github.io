#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#duration
xsd:duration rdf:type rdfs:Datatype .


###  https://ptb.de/dcc/formulaType
dcc:formulaType rdf:type rdfs:Datatype ;
                rdfs:comment "A data type to express formulae in a markup language such as MathML or LaTeX. The preferred syntax is Semantic MathML."@en ;
                rdfs:label "Formel"@de ,
                           "formula"@en ;
                skos:editorialNote "harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  https://schema.org/DateTime
schema:DateTime rdf:type rdfs:Datatype ;
                rdfs:comment "A combination of date and time of day in the form [-]CCYY-MM-DDThh:mm:ss[Z|(+|-)hh:mm] (see Chapter 5.4 of ISO 8601)"@en ;
                rdfs:label "Datum mit Zeit"@de ,
                           "date with time"@en ;
                skos:editorialNote "changed by m4i: added rdfs:label, added German label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


#################################################################
#    Object Properties
#################################################################

###  http://mlcommons.org/croissant/field
cr:field rdf:type owl:ObjectProperty ;
         rdfs:domain cr:RecordSet ;
         rdfs:range cr:Field ;
         rdfs:comment "A data element that appears in the records of the RecordSet (e.g., one column of a table)."@en ,
                      "Ein Datenelement, das in den Einträgen eines RecordSets erscheint (z.B. eine Spalte einer Tabelle)"@de ;
         rdfs:label "has field"@en ,
                    "hat Feld"@de ;
         skos:editorialNote "changed by m4i: added German labels, changed english label to 'has field' to remove duplicates, removed schema:rangeIncludes and schema:domainIncludes properties"@en .


###  http://mlcommons.org/croissant/source
cr:source rdf:type owl:ObjectProperty ;
          rdfs:comment "Die Datenquelle eines Feldes in einem Datensatz. Referenziert in der Regel ein cr:FileObject oder cr:FileSet"@de ,
                       "The data source of the field. This will generally reference a FileObject or FileSet's contents (e.g., a specific column of a table)."@en ;
          rdfs:label "Quelle"@de ,
                     "source"@en ;
          skos:editorialNote "changed by m4i: added rdfs:label and rdfs:comment, added German labels, removed schema:rangeIncludes and schema:domainIncludes properties"@en .


###  http://purl.obolibrary.org/obo/BFO_0000050
obo:BFO_0000050 rdf:type owl:ObjectProperty ;
                owl:inverseOf obo:BFO_0000051 ;
                rdf:type owl:TransitiveProperty ;
                rdfs:comment "a core relation that holds between a part and its whole"@en ;
                rdfs:label "Teil von"@de ,
                           "part of"@en ;
                skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en ,
                                   "changed by m4i: copied obo:IAO_0000115 to a rdfs:comment"@en .


###  http://purl.obolibrary.org/obo/BFO_0000051
obo:BFO_0000051 rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                rdfs:comment "a core relation that holds between a whole and its part"@en ;
                rdfs:label "has part"@en ,
                           "hat Teil"@de ;
                skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en ,
                                   "changed by m4i: copied obo:IAO_0000115 to a rdfs:comment"@en .


###  http://purl.obolibrary.org/obo/BFO_0000054
obo:BFO_0000054 rdf:type owl:ObjectProperty ;
                owl:inverseOf obo:BFO_0000055 ;
                rdfs:domain obo:BFO_0000017 ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:comment "Paraphrase of elucidation: a relation between a realizable entity and a process, where there is some material entity that is bearer of the realizable entity and participates in the process, and the realizable entity comes to be realized in the course of the process" ;
                rdfs:isDefinedBy obo: ;
                rdfs:label "realisiert in"@de ,
                           "realized in"@en ;
                skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  http://purl.obolibrary.org/obo/BFO_0000055
obo:BFO_0000055 rdf:type owl:ObjectProperty ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range obo:BFO_0000017 ;
                rdfs:comment "Paraphrase of elucidation: a relation between a process and a realizable entity, where there is some material entity that is bearer of the realizable entity and participates in the process, and the realizable entity comes to be realized in the course of the process" ;
                rdfs:isDefinedBy obo: ;
                rdfs:label "realisiert"@de ,
                           "realizes"@en ;
                skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  http://purl.obolibrary.org/obo/BFO_0000063
obo:BFO_0000063 rdf:type owl:ObjectProperty ,
                         owl:TransitiveProperty ;
                rdfs:domain obo:BFO_0000015 ;
                rdfs:range obo:BFO_0000015 ;
                rdfs:comment "x precedes y if and only if the time point at which x ends is before or equivalent to the time point at which y starts. Formally: x precedes y iff ω(x) <= α(y), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point."@en ;
                rdfs:label "geschieht vor"@de ,
                           "precedes"@en .


###  http://purl.obolibrary.org/obo/RO_0000056
obo:RO_0000056 rdf:type owl:ObjectProperty ;
               owl:inverseOf obo:RO_0000057 ;
               rdfs:comment "a relation between a continuant and a process, in which the continuant is somehow involved in the process"@en ;
               rdfs:label "ist beteiligt an"@de ,
                          "participates in"@en ;
               skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en ,
                                  "changed by m4i: copied obo:IAO_0000115 to a rdfs:comment"@en .


###  http://purl.obolibrary.org/obo/RO_0000057
obo:RO_0000057 rdf:type owl:ObjectProperty ;
               owl:propertyChainAxiom ( prov:qualifiedAssociation
                                        prov:agent
                                      ) ;
               rdfs:comment "a relation between a process and a continuant, in which the continuant is somehow involved in the process"@en ;
               rdfs:label "has participant"@en ,
                          "hat Teilnehmer"@de ;
               skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en ,
                                  "changed by m4i: added a property chain axiom for use with prov:qualifiedAssociation"@en ,
                                  "changed by m4i: copied obo:IAO_0000115 to a rdfs:comment"@en .


###  http://purl.obolibrary.org/obo/RO_0002090
obo:RO_0002090 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000063 ;
               rdfs:domain obo:BFO_0000015 ;
               rdfs:range obo:BFO_0000015 ;
               rdfs:comment "X immediately precedes_Y iff: end(X) simultaneous_with start(Y)" ;
               rdfs:label "geschieht unmittelbar vor"@de ,
                          "immediately precedes"@en ;
               skos:editorialNote "changed by m4i: added rdfs:label"@en .


###  http://purl.obolibrary.org/obo/RO_0002224
obo:RO_0002224 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000051 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:domain m4i:ProcessingStep ;
               rdfs:range m4i:ProcessingStep ;
               rdfs:comment "x starts with y if and only if x has part y and the time point at which x starts is equivalent to the time point at which y starts. Formally: α(y) = α(x) ∧ ω(y) < ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point."@en ;
               rdfs:label "beginnt mit"@de ,
                          "starts with"@en ;
               rdfs:seeAlso <http://ontologydesignpatterns.org/wiki/Submissions:Componency> ;
               skos:altLabel "started by"@en ;
               skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  http://purl.obolibrary.org/obo/RO_0002230
obo:RO_0002230 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:BFO_0000051 ;
               rdf:type owl:TransitiveProperty ;
               rdfs:domain m4i:ProcessingStep ;
               rdfs:range m4i:ProcessingStep ;
               rdfs:comment "x ends with y if and only if x has part y and the time point at which x ends is equivalent to the time point at which y ends. Formally: α(y) > α(x) ∧ ω(y) = ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point."@en ;
               rdfs:label "endet mit"@de ,
                          "ends with"@en ;
               skos:altLabel "finished by"@en ;
               skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  http://purl.obolibrary.org/obo/RO_0002233
obo:RO_0002233 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000057 ;
               owl:inverseOf obo:RO_0002352 ;
               rdfs:comment "(x has input y) means x takes specific input as y for further processes"@en ;
               rdfs:label "has input"@en ,
                          "hat Input"@de ;
               skos:editorialNote "changed by m4i: added rdfs:label"@en .


###  http://purl.obolibrary.org/obo/RO_0002234
obo:RO_0002234 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000057 ;
               owl:inverseOf obo:RO_0002353 ;
               rdfs:comment "(x has output y) means x provides specific output y for the result or further processes"@en ;
               rdfs:label "has output"@en ,
                          "hat Output"@de ;
               skos:editorialNote "changed by m4i: added rdfs:label"@en .


###  http://purl.obolibrary.org/obo/RO_0002352
obo:RO_0002352 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000056 ;
               rdfs:comment "(x input of y) means x is a specific input of y to carry out further processes"@en ;
               rdfs:label "Input von"@de ,
                          "input of"@en ;
               skos:editorialNote "changed by m4i: added rdfs:label"@en .


###  http://purl.obolibrary.org/obo/RO_0002353
obo:RO_0002353 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf obo:RO_0000056 ;
               rdfs:comment "(x output of y) means x is the specific output of y as the result or further processes"@en ;
               rdfs:label "Output von"@de ,
                          "output of"@en ;
               skos:editorialNote "changed by m4i: added rdfs:label"@en .


###  http://semanticscience.org/resource/SIO_000001
sio:SIO_000001 rdf:type owl:ObjectProperty ;
               rdfs:comment "A is related to B if there is some relation between A and B."@en ,
                            "A ist verwandt zu B wenn eine Beziehnung zwischen beiden besteht."@de ;
               rdfs:label "is related to"@en ,
                          "ist verwandt mit"@de ;
               skos:editorialNote "changed by m4i: added rdfs:label, added German labels" .


###  http://semanticscience.org/resource/SIO_000210
sio:SIO_000210 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf sio:SIO_000628 ;
               rdfs:comment "A represents B when A serves as a sign, symbol or model of B."@en ,
                            "A repräsentiert B wenn es als ein Zeichen, Symbol oder Modell von B dient."@de ;
               rdfs:label "represents"@en ,
                          "repräsentiert"@de ;
               skos:editorialNote "changed by m4i: added rdfs:label, added German labels" .


###  http://semanticscience.org/resource/SIO_000628
sio:SIO_000628 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf sio:SIO_000001 ;
               rdfs:comment "bezieht sich auf ist eine Relation zwischen einer Entität und einer anderen Entität, auf die sie sich bezieht."@de ,
                            "refers to is a relation between one entity and the entity that it makes reference to."@en ;
               rdfs:label "bezieht sich auf"@de ,
                          "refers to"@en ;
               skos:editorialNote "changed by m4i: added rdfs:label, added German labels" .


###  http://w3id.org/nfdi4ing/metadata4ing#configures
m4i:configures rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain m4i:Configuration ;
               rdfs:range [ rdf:type owl:Class ;
                            owl:unionOf ( m4i:Method
                                          m4i:Tool
                                        )
                          ] ;
               rdfs:comment "References a tool or method that is configured by a setup configuration."@en ,
                            "Referenziert ein durch eine Konfiguration konfiguriertes Werkzeug oder eine Methode."@de ;
               rdfs:label "configures"@en ,
                          "konfiguriert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasAdmissibleUnit
m4i:hasAdmissibleUnit rdf:type owl:ObjectProperty ;
                      owl:inverseOf pims-ii:isAdmissibleUnitFor ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( qudt:QuantityKind
                                                  m4i:NumericalVariable
                                                )
                                  ] ;
                      rdfs:range qudt:Unit ;
                      obo:IAO_0000231 obo:IAO_000028 ;
                      obo:IAO_0100001 sirp:hasUnit ;
                      rdfs:comment "OBSOLETE. (x hasAdmissibleUnit y) means that y is a unit that can be associated with the variable x"@en ,
                                   "redundant information: applicable unit can be deduced from quantity kind. If one wants to enforce the use of a specific unit, use a SHACL constraint." ;
                      rdfs:label "obsolet hat als zulässige Einheit"@de ,
                                 "obsolete has admissible unit"@en ;
                      owl:deprecated "true"^^xsd:boolean ;
                      skos:editorialNote "Deprecated in version 1.4.0: replaced by sirp:hasUnit"@en ,
                                         "changed by m4i: updated rdfs:range"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasAdmissibleValue
m4i:hasAdmissibleValue rdf:type owl:ObjectProperty ;
                       owl:inverseOf pims-ii:isAdmissibleValueFor ;
                       rdfs:domain pims-ii:Variable ;
                       rdfs:range pims-ii:Value ;
                       rdfs:comment "(x hasAdmissibleValue y) means that y is a value that can be assigned to the variable x"@en ;
                       rdfs:label "has admissible value"@en ,
                                  "hat als zulässigen Wert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasAssignedParameter
m4i:hasAssignedParameter rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf m4i:hasParameter ;
                         rdfs:range pims-ii:Variable ;
                         rdfs:comment "Referenziert einen Parameter, der zur Laufzeit konfiguriert wird."@de ,
                                      "Refers to a parameter that is assigned at run time."@en ;
                         rdfs:label "has assigned parameter"@en ,
                                    "hat zugewiesenen Parameter"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasAssignedParameterSet
m4i:hasAssignedParameterSet rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf m4i:hasParameterSet ;
                            rdfs:range m4i:VariableSet ;
                            rdfs:comment "Referenziert eine Menge von Parametern, die zur Laufzeit konfiguriert wird."@de ,
                                         "Refers to a set of parameters that are assigned at run time."@en ;
                            rdfs:label "has assigned parameter set"@en ,
                                       "hat zugewiesenen Parametersatz"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasAssignedValue
m4i:hasAssignedValue rdf:type owl:ObjectProperty ;
                     owl:inverseOf pims-ii:isValueInAssignment ;
                     rdfs:domain pims-ii:Assignment ;
                     rdfs:range pims-ii:Value ;
                     rdfs:comment "(a hasAssignedValue y) means that a: x = y is an assignment where the value y is assigned to a variable x"@en ;
                     rdfs:label "has assigned value"@en ,
                                "hat zugewiesenen Wert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasCoverageInterval
m4i:hasCoverageInterval rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf m4i:hasUncertaintyDeclaration ;
                        rdfs:domain m4i:NumericalVariable ;
                        rdfs:range six:CoverageInterval ;
                        obo:IAO_0000231 obo:IAO_000028 ;
                        obo:IAO_0100001 sis:hasCoverageIntervalMU ;
                        rdfs:comment "OBSOLETE. Associates an six:Real quantity value with an six:CoverageInterval"@en ;
                        rdfs:label "obsolet hat Überdeckungsintervall"@de ,
                                   "obsolete has coverage interval"@en ;
                        owl:deprecated "true"^^xsd:boolean ;
                        skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:hasCoverageIntervalMU"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasEmployedSoftware
m4i:hasEmployedSoftware rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf m4i:hasEmployedTool ;
                        rdfs:range schema:SoftwareApplication ;
                        rdfs:comment "Points to a software application that was used within a processing step."@en ,
                                     "Zeigt auf eine Software, die innerhalb eines Prozessschrittes verwendet wurde."@de ;
                        rdfs:label "has employed software"@en ,
                                   "hat eingesetzte Software"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasEmployedTool
m4i:hasEmployedTool rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf schema:instrument ;
                    owl:inverseOf m4i:isEmployedToolIn ;
                    rdfs:domain m4i:ProcessingStep ;
                    rdfs:range m4i:Tool ;
                    rdfs:comment "Points to a tool that is used within a given processing step"@en ,
                                 "Verweist auf ein Werkzeug, das in einem Arbeitsschritt verwendet wurde"@de ;
                    rdfs:label "has employed tool"@en ,
                               "hat eingesetztes Werkzeug"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasExpandedUnc
m4i:hasExpandedUnc rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf m4i:hasUncertaintyDeclaration ;
                   rdfs:domain m4i:NumericalVariable ;
                   rdfs:range six:CoverageInterval ;
                   obo:IAO_0000231 obo:IAO_000028 ;
                   obo:IAO_0100001 sis:hasExpandedMU ;
                   rdfs:comment "OBSOLETE. Relates an six:Real to its expanded uncertainty"@en ;
                   rdfs:label "obsolet hat erweiterte Unsicherheit"@de ,
                              "obsolete has expanded uncertainty"@en ;
                   owl:deprecated "true"^^xsd:boolean ;
                   skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:hasExpandedMU"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasFile
m4i:hasFile rdf:type owl:ObjectProperty ;
            rdfs:domain m4i:Configuration ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( cr:FileObject
                                       cr:FileSet
                                     )
                       ] ;
            rdfs:comment "Links a configuration to a file object or file set that contains its parameters, f.e. a manufacturer sheet"@en ,
                         "Verbindet eine Konfiguration mit einem Dateiobject oder einer Dateimenge, die deren Parameter enthält, bspw. einem Informationsblatt."@de ;
            rdfs:label "has file"@en ,
                       "hat Datei"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasFixedParameter
m4i:hasFixedParameter rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf m4i:hasParameter ;
                      rdfs:range pims-ii:Variable ;
                      rdfs:comment "Referenziert einen festen Parameter, der sich nicht zur Laufzeit ändert."@de ,
                                   "Refers to a parameter that describes a stable property that does not change on runtime."@en ;
                      rdfs:label "has fixed parameter"@en ,
                                 "hat festen Parameter"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasFixedParameterSet
m4i:hasFixedParameterSet rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf m4i:hasParameterSet ;
                         rdfs:range m4i:VariableSet ;
                         rdfs:comment "Referenziert einen festen Parametersatz, der sich nicht zur Laufzeit ändert."@de ,
                                      "Refers to a parameter set that describes stable properties that does not change on runtime."@en ;
                         rdfs:label "has fixed parameter set"@en ,
                                    "hat festen Parametersatz"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasKindOfQuantity
m4i:hasKindOfQuantity rdf:type owl:ObjectProperty ;
                      rdfs:domain m4i:NumericalVariable ;
                      rdfs:range [ rdf:type owl:Class ;
                                   owl:unionOf ( qudt:QuantityKind
                                                 sirp:QuantityKind
                                               )
                                 ] ;
                      rdfs:comment "Points to the property characterization (i.e., to the kind of quantity) from a controlled vocabulary"@en ;
                      rdfs:label "has kind of quantity"@en ,
                                 "hat Größenart"@de ;
                      skos:exactMatch sis:hasQuantityType ;
                      skos:note "We recommend using a persistent identifier resolving to a persistent IRI from a controlled vocabulary, preferably the SI Reference Point https://si-digital-framework.org/quantities/ or QUDT http://qudt.org/vocab/quantitykind (alternatively: IEC CDD https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/TreeFrameset or ISO 80000 https://www.iso.org/obp/ui)."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasParameter
m4i:hasParameter rdf:type owl:ObjectProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( m4i:Method
                                             m4i:Tool
                                           )
                             ] ;
                 rdfs:range pims-ii:Variable ;
                 rdfs:comment "Points to a parameter of a given method or tool."@en ;
                 rdfs:label "has parameter"@en ,
                            "hat Parameter"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasParameterSet
m4i:hasParameterSet rdf:type owl:ObjectProperty ;
                    rdfs:range m4i:VariableSet ;
                    rdfs:comment "Referenziert eine Menge von Parametern beispielsweise einer Methode oder eines Werkzeugs."@de ,
                                 "Refers to a set of parameters of e.g. a tool or a method."@en ;
                    rdfs:label "has parameter set"@en ,
                               "hat Parametersatz"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasRelatedPublication
m4i:hasRelatedPublication rdf:type owl:ObjectProperty ;
                          rdfs:domain dcat:Dataset .


###  http://w3id.org/nfdi4ing/metadata4ing#hasRelatedPublikation
m4i:hasRelatedPublikation rdf:type owl:ObjectProperty ;
                          rdfs:comment "Points to a biblographic record like a scientific paper that references the dataset."@en ,
                                       "Zeigt auf einen bibliographischen Eintrag, wie beispielsweise ein wissenschaftlicher Artikel, der einen Datensatz referenziert."@de ;
                          rdfs:label "has related publication"@en ,
                                     "hat zugehörige Publikation"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasRuntimeAssignment
m4i:hasRuntimeAssignment rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf obo:RO_0000057 ,
                                            [ owl:inverseOf pims-ii:isAssignmentFor
                                            ] ;
                         rdfs:domain m4i:ProcessingStep ;
                         rdfs:range pims-ii:Assignment ;
                         rdfs:comment "Points to an assignment that is neither input nor output"@en ;
                         rdfs:label "has runtime assignment"@en ,
                                    "hat Laufzeitzuweisung"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasUncertaintyDeclaration
m4i:hasUncertaintyDeclaration rdf:type owl:ObjectProperty ;
                              rdfs:domain m4i:NumericalVariable ;
                              rdfs:range sis:MeasurementUncertainty ;
                              rdfs:comment "Associates a quantity value with its mandatory uncertainty declaration (i.e., with an expanded uncertainty or a coverage interval)"@en ;
                              rdfs:label "has uncertainty declaration"@en ,
                                         "hat Unsicherheitsdeklaration"@de ;
                              skos:editorialNote "changed by m4i: updated rdf:type, rdfs:comment, rdfs:range"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasUnit
m4i:hasUnit rdf:type owl:ObjectProperty ;
            rdfs:domain m4i:NumericalVariable ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( qudt:Unit
                                       sirp:MeasurementUnit
                                     )
                       ] ;
            rdfs:comment "Represents the unit of a numerical value (real or complex or list)"@en ,
                         "Repräsentiert die Einheit eines numerischen Wertes (reell oder complex oder Liste)"@de ;
            rdfs:label "has unit"@en ,
                       "hat Einheit"@de ;
            skos:closeMatch qudt:unit ;
            skos:editorialNote "changed by m4i: updated skos:closeMatch, skos:note"@en ;
            skos:exactMatch sis:hasMeasurementUnit ;
            skos:note "Kardinalität dieser Property bei der Beschreibung eines sis:Real: 0-1"@de ,
                      "Obligation dieser Property bei der Beschreibung eines sis:Real: recommended"@de ,
                      "We recommend using a persistent identifier resolving to a persistent IRI from a controlled vocabulary, preferably the SI Reference Point https://si-digital-framework.org/SI/units/ or QUDT http://qudt.org/vocab/unit (alternatively: IEC CDD https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/TreeFrameset or ISO 80000 https://www.iso.org/obp/ui)."@en ,
                      "cardinality of this property for the description of a sis:Real: 0-1"@en ,
                      "obligation of this property for the description of a sis:Real: recommended"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasVariable
m4i:hasVariable rdf:type owl:ObjectProperty ;
                owl:inverseOf pims-ii:isVariableInAssignment ;
                rdfs:domain pims-ii:Assignment ;
                rdfs:range pims-ii:Variable ;
                rdfs:comment "( a hasVariable x ) bedeutet, dass a: x = y eine Variablenzuordnung ist, in der der Variablen x ein Wert zugeordnet wird."@de ,
                             "( a hasVariable x ) means that a: x = y is an assignment where the value y is assigned to a variable x"@en ;
                rdfs:label "has variable"@en ,
                           "hat Variable"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#implementedByTool
m4i:implementedByTool rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf ssn:implementedBy ;
                      owl:inverseOf m4i:implementsMethod ;
                      rdfs:domain m4i:Method ;
                      rdfs:range m4i:Tool ;
                      rdfs:comment "Points to a tool that implements a given method"@en ;
                      rdfs:label "implemented by"@en ,
                                 "wird implementiert durch"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#implementsMethod
m4i:implementsMethod rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf ssn:implements ;
                     rdfs:domain m4i:Tool ;
                     rdfs:range m4i:Method ;
                     rdfs:comment "Points to a method that is implemented by a given tool"@en ;
                     rdfs:label "implementiert"@de ,
                                "implements"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#inProject
m4i:inProject rdf:type owl:ObjectProperty ;
              owl:inverseOf m4i:projectParticipant ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( prov:Organization
                                          prov:Person
                                        )
                          ] ;
              rdfs:range schema:Project ;
              rdfs:comment "A property that connects a person or an organization with a project."@en ;
              rdfs:label "associated to project"@en ,
                         "gehört zu Projekt"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#includesConfiguredProperty
m4i:includesConfiguredProperty rdf:type owl:ObjectProperty ;
                               rdfs:range m4i:Variable ;
                               owl:propertyChainAxiom ( m4i:wasGeneratedBy
                                                        m4i:usesConfiguration
                                                        m4i:hasParameterSet
                                                        obo:BFO_0000051
                                                      ) ;
                               rdfs:comment "Points to a variable as a part of a dataset that was part of a configuration of a processing step."@en ,
                                            "Zeigt auf eine Variable als Teil eines Datensatzes, die Teil einer Konfiguration eines Prozesses, einer Methode oder eines Tools im Rahmen eines wissenschaftlichen Prozesses ist."@de ;
                               rdfs:label "beinhaltet konfigurierte Eigenschaft"@de ,
                                          "includes configured property"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#includesInvestigatedProperty
m4i:includesInvestigatedProperty rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf schema:variableMeasured ;
                                 rdfs:range m4i:Variable ;
                                 owl:propertyChainAxiom ( m4i:wasGeneratedBy
                                                          m4i:investigatesProperty
                                                        ) ;
                                 rdfs:comment "Points to a variable as a part of a dataset that was a property of interest of a processing step like a experimentally measured or numerically simulated quantity."@en ,
                                              "Zeigt auf eine Variable als Teil eines Datensatzes, die im Zentrum des Interesses eines wissenschaftlichen Prozesses stand, wie z.B. eine experimentell oder durch Simulation ermittelte Größe."@de ;
                                 rdfs:label "beinhaltet untersuchte Eigenschaft"@de ,
                                            "includes investigated property"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#investigates
m4i:investigates rdf:type owl:ObjectProperty ;
                 rdfs:domain m4i:ProcessingStep ;
                 rdfs:range owl:Thing ;
                 rdfs:comment "(x investigates y) means that x is about y, in the context of scientific research and development"@en ;
                 rdfs:label "investigates"@en ,
                            "untersucht"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#investigatesProperty
m4i:investigatesProperty rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf m4i:investigates ;
                         rdfs:domain m4i:ProcessingStep ;
                         rdfs:range m4i:Variable ;
                         rdfs:comment "(x investigatesProperty y) means that x is about target property y, in the context of scientific research and development"@en ;
                         rdfs:label "investigates property"@en ,
                                    "untersucht Eigenschaft"@de ;
                         skos:broader emmo:EMMO_60577dea_9019_4537_ac41_80b0fb563d41 ,
                                      pims-ii:hasRepresentamen .


###  http://w3id.org/nfdi4ing/metadata4ing#isAbout
m4i:isAbout rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf schema:about ;
            rdfs:domain dcat:Dataset ;
            owl:propertyChainAxiom ( m4i:wasGeneratedBy
                                     m4i:investigates
                                   ) ;
            rdfs:comment "Points to the object of a research process, e.g. a research problem, a research subject or a material"@en ,
                         "Zeigt auf das Forschungsobjekt, das im Rahmen eines Forschungsprozesses untersucht wurde, z.B. eine Forschungsfragestellung, ein Forschungsgegenstand oder ein Material."@de ;
            rdfs:label "behandelt"@de ,
                       "is about"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#isConfiguredBy
m4i:isConfiguredBy rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ;
                   rdfs:range m4i:Configuration ;
                   rdfs:comment "References a setup configuration of f.e. a tool a method or a processing step."@en ,
                                "Referenziert eine Konfiguration, durch die bspw. ein Werkzeug oder eine Methode konfiguriert wird."@de ;
                   rdfs:label "is configured by"@en ,
                              "wird konfiguriert durch"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#isConfiguredByFile
m4i:isConfiguredByFile rdf:type owl:ObjectProperty ;
                       rdfs:range [ rdf:type owl:Class ;
                                    owl:unionOf ( cr:FileObject
                                                  cr:FileSet
                                                )
                                  ] ;
                       owl:propertyChainAxiom ( m4i:isConfiguredBy
                                                m4i:hasFile
                                              ) ;
                       rdfs:comment "Points to a file object or a file set that contains parameters of a configuration, f.e. a manufacturer sheet."@en ,
                                    "Referenziert ein Dateiobject oder eine Dateimenge, die Konfigurationsparameter enthält, bspw. ein Informationsblatt."@de ;
                       rdfs:label "is configured by file(set)"@en ,
                                  "wird durch Datei(menge) konfiguriert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#isConfiguredByParameter
m4i:isConfiguredByParameter rdf:type owl:ObjectProperty ;
                            rdfs:range m4i:Variable ;
                            owl:propertyChainAxiom ( m4i:isConfiguredBy
                                                     m4i:hasParameter
                                                   ) ;
                            rdfs:comment "Points to a variable that configures f.e. a processing step, a method or a tool."@en ,
                                         "Referenziert eine Variable, durch die bspw. einen Arbeitsschritt, ein Werkzeug oder eine Methode konfiguriert wird."@de ;
                            rdfs:label "is configured by parameter"@en ,
                                       "wird durch Parameter konfiguriert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#isConfiguredByParameterSet
m4i:isConfiguredByParameterSet rdf:type owl:ObjectProperty ;
                               rdfs:range m4i:VariableSet ;
                               owl:propertyChainAxiom ( m4i:isConfiguredBy
                                                        m4i:hasParameterSet
                                                      ) ;
                               rdfs:comment "Points to a variable set that contains parameters of a configuration."@en ,
                                            "Referenziert eine Sammlung von Variablen, die aus Konfigurationsparametern besteht."@de ;
                               rdfs:label "is configured by parameter set"@en ,
                                          "wird durch Parametersatz konfiguriert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#isEmployedToolIn
m4i:isEmployedToolIn rdf:type owl:ObjectProperty ;
                     rdfs:domain m4i:Tool ;
                     rdfs:range m4i:ProcessingStep ;
                     rdfs:comment "Points to a processing step the tool has been used in"@en ,
                                  "Verweist auf einen Arbeitsschritt, in dem das Werkzeug eingesetzt wurde"@de ;
                     rdfs:label "is employed tool"@en ,
                                "ist eingesetztes Werkzeug"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#projectParticipant
m4i:projectParticipant rdf:type owl:ObjectProperty ;
                       rdfs:domain schema:Project ;
                       rdfs:range [ rdf:type owl:Class ;
                                    owl:unionOf ( prov:Organization
                                                  prov:Person
                                                )
                                  ] ;
                       rdfs:comment "A property that connects a project with a person or an organisation."@en ;
                       rdfs:label "hat Projektmitglied"@de ,
                                  "project participant"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#realizesMethod
m4i:realizesMethod rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf obo:BFO_0000055 ;
                   rdfs:domain m4i:ProcessingStep ;
                   rdfs:range m4i:Method ;
                   rdfs:comment "Points to a method that is used within a given processing step"@en ;
                   rdfs:label "realisiert Methode"@de ,
                              "realizes method"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#representsVariable
m4i:representsVariable rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf sio:SIO_000210 ;
                       rdfs:domain cr:Field ;
                       rdfs:range pims-ii:Variable ;
                       rdfs:comment "Points to a variable that is represented through a field within a recordset"@en ;
                       rdfs:label "represents variable"@en ,
                                  "repräsentiert Variable"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#requiresSoftware
m4i:requiresSoftware rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf schema:softwareRequirements ;
                     rdfs:range schema:SoftwareApplication ;
                     rdfs:comment "Points to a software application that is required to work with a dataset."@en ,
                                  "Zeigt auf eine Software, die zur Bearbeitung eines Datensatzes benötigt wird."@de ;
                     rdfs:label "benötigt Software"@de ,
                                "requires software"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#usesConfiguration
m4i:usesConfiguration rdf:type owl:ObjectProperty ;
                      rdfs:domain m4i:ProcessingStep ;
                      rdfs:range m4i:Configuration ;
                      rdfs:comment "References a configuration of parameters that is used in a processing step to set up a method or tool."@en ,
                                   "Referenziert eine in einem Arbeitsschritt zur Einstellung einer Methode oder eines Werkzeugs verwendete Parameterkonfiguration."@de ;
                      rdfs:label "uses configuration"@en ,
                                 "verwendet Konfiguration"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#wasGeneratedBy
m4i:wasGeneratedBy rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf prov:wasGeneratedBy ;
                   rdfs:range m4i:ProcessingStep ;
                   rdfs:comment "Points to a process or processing step that generated a dataset."@en ,
                                "Zeigt auf einen Prozess(schritt), der einen Datensatz erzeugt hat."@de .


###  http://w3id.org/nfdi4ing/metadata4ing#wasGeneratedByMethod
m4i:wasGeneratedByMethod rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf schema:measurementTechnique ;
                         rdfs:range m4i:Method ;
                         owl:propertyChainAxiom ( m4i:wasGeneratedBy
                                                  m4i:realizesMethod
                                                ) ;
                         rdfs:comment "Points to a scientific method or technique that is used to generate a dataset."@en ,
                                      "Zeigt auf eine Methode, die zur Erzeugung eines Datensatzes genutzt wurde."@de ;
                         rdfs:label "was generated by method"@en ,
                                    "wurde erzeugt mit Hilfe von Methode"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#wasGeneratedBySoftware
m4i:wasGeneratedBySoftware rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf schema:measurementTechnique ;
                           rdfs:range schema:SoftwareApplication ;
                           owl:propertyChainAxiom ( m4i:wasGeneratedBy
                                                    m4i:hasEmployedSoftware
                                                  ) ;
                           rdfs:comment "Points to a software application that was used to generate a dataset."@en ,
                                        "Zeigt auf eine Software, die zur Erzeugung eines Datensatzes genutzt wurde."@de ;
                           rdfs:label "was generated by software"@en ,
                                      "wurde erzeugt mit Hilfe von Software"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#wasGeneratedByTool
m4i:wasGeneratedByTool rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf schema:measurementTechnique ;
                       rdfs:range m4i:Tool ;
                       owl:propertyChainAxiom ( m4i:wasGeneratedBy
                                                m4i:hasEmployedTool
                                              ) ;
                       rdfs:comment "Points to a instrument or tool that was used to generate a dataset."@en ,
                                    "Zeigt auf ein Instrument oder Werkzeug, das zur Erzeugung eines Datensatzes genutzt wurde."@de ;
                       rdfs:label "was generated by tool"@en ,
                                  "wurde erzeugt mit Hilfe von Werkzeug"@de .


###  http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleUnitFor
pims-ii:isAdmissibleUnitFor rdf:type owl:ObjectProperty ;
                            rdfs:domain qudt:Unit ;
                            rdfs:range [ rdf:type owl:Class ;
                                         owl:unionOf ( qudt:QuantityKind
                                                       m4i:NumericalVariable
                                                     )
                                       ] ;
                            obo:IAO_0000231 obo:IAO_000028 ;
                            obo:IAO_0100001 sirp:isUnitOfQtyKind ;
                            rdfs:comment "OBSOLETE. (x isAdmissibleUnitFor y) means that x is a unit that can be associated with the variable y; subsumption under msHPIPIR is explained as follows: There is a sign z for the variable y (where z is a description of admissible values of y) of which x is constitutive (and with which x hence overlaps)"@en ,
                                         "redundant information: admissible unit can be deduced from quantity kind. If one wants to enforce the use of a specific unit, use a SHACL contraint." ;
                            rdfs:label "obsolet ist zulässige Einheit für"@de ,
                                       "obsolete is admissible unit for"@en ;
                            owl:deprecated "true"^^xsd:boolean ;
                            skos:editorialNote "Deprecated in version 1.4.0: replaced by sirp:isUnitOfQtyKind"@en ,
                                               "changed by m4i: added rdfs:label, adjusted German labels, harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.molmod.info/semantics/pims-ii.ttl#isAdmissibleValueFor
pims-ii:isAdmissibleValueFor rdf:type owl:ObjectProperty ;
                             rdfs:domain pims-ii:Value ;
                             rdfs:range pims-ii:Variable ;
                             rdfs:comment "(x isAdmissibleValueFor y) means that x is a value that can be assigned to the variable y; subsumption under msIPIRIR is explained as follows: There is a sign z for the variable y (where z is the range of admissible values of y), for which in turn there is another sign z' (where z' lists members of z, explicitly including x) of which x is a part"@en ;
                             rdfs:label "is admissible value for"@en ,
                                        "ist zulässiger Wert für"@de ;
                             skos:editorialNote "changed by m4i: added rdfs:label, adjusted German labels, harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.molmod.info/semantics/pims-ii.ttl#isAssignmentFor
pims-ii:isAssignmentFor rdf:type owl:ObjectProperty ;
                        rdfs:domain pims-ii:Assignment ;
                        rdfs:comment "(o isAssignment for d) means that d: x = y is an assignment that refers to o; e.g., x may be temperature, y may be a temperature value, and o may be an object of which the temperature has been measured or some other context to which the assignment refers"@en ;
                        rdfs:label "is assignment for"@en ,
                                   "ist Zuweisung in Bezug auf"@de ;
                        skos:broader pims-ii:isRepresentamenFor ;
                        skos:editorialNote "changed by m4i: added rdfs:label, adjusted German labels, harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.molmod.info/semantics/pims-ii.ttl#isValueInAssignment
pims-ii:isValueInAssignment rdf:type owl:ObjectProperty ;
                            rdfs:domain pims-ii:Value ;
                            rdfs:range pims-ii:Assignment ;
                            rdfs:comment "(y isValueInAssignment a) means that a: x = y is an assignment where the value y is assigned to a variable x"@en ;
                            rdfs:label "is value in assignment"@en ,
                                       "ist Wert in Zuweisung"@de ;
                            skos:broader pims-ii:isSemioticallyConstitutiveOf ;
                            skos:editorialNote "changed by m4i: added rdfs:label, adjusted German labels, harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.molmod.info/semantics/pims-ii.ttl#isVariableInAssignment
pims-ii:isVariableInAssignment rdf:type owl:ObjectProperty ;
                               rdfs:domain pims-ii:Variable ;
                               rdfs:range pims-ii:Assignment ;
                               rdfs:comment "(x isVariableInAssignment a) means that a: x = y is an assignment where a value y is assigned to the variable x"@en ;
                               rdfs:label "is variable in assignment"@en ,
                                          "ist Variable in Zuweisung"@de ;
                               skos:broader pims-ii:isSemioticallyConstitutiveOf ;
                               skos:editorialNote "changed by m4i: added rdfs:label, adjusted German labels, harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.w3.org/ns/dcat#compressFormat
dcat:compressFormat rdf:type owl:ObjectProperty ;
                    rdfs:domain dcat:Distribution ;
                    rdfs:comment "The compression format of the distribution in which the data is contained in a compressed form, e.g. to reduce the size of the downloadable file."@en ;
                    rdfs:isDefinedBy dcat: ;
                    rdfs:label "Kompressionsformat"@de ,
                               "compression format"@en ;
                    skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
                    skos:scopeNote "This property is to be used when the files in the distribution are compressed, e.g. in a ZIP file. The format SHOULD be expressed using a media type as defined by IANA media types registry https://www.iana.org/assignments/media-types/, if available."@en .


###  http://www.w3.org/ns/dcat#distribution
dcat:distribution rdf:type owl:ObjectProperty ;
                  rdfs:domain dcat:Dataset ;
                  rdfs:range dcat:Distribution ;
                  rdfs:comment "An available distribution of the dataset."@en ;
                  rdfs:isDefinedBy dcat: ;
                  rdfs:label "has distribution"@en ,
                             "hat Verteilung"@de ;
                  skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en .


###  http://www.w3.org/ns/dcat#downloadURL
dcat:downloadURL rdf:type owl:ObjectProperty ;
                 rdfs:domain dcat:Distribution ;
                 rdfs:comment "The URL of the downloadable file in a given format. E.g. CSV file or RDF file. The format is indicated by the distribution's dcterms:format and/or dcat:mediaType."@en ;
                 rdfs:isDefinedBy dcat: ;
                 rdfs:label "Downloadlink"@de ,
                            "download URL"@en ;
                 skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
                 skos:scopeNote "dcat:downloadURL SHOULD be used for the address at which this distribution is available directly, typically through a HTTP Get request."@en .


###  http://www.w3.org/ns/dcat#inSeries
dcat:inSeries rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf obo:BFO_0000050 ;
              rdfs:domain dcat:Dataset ;
              rdfs:range dcat:DatasetSeries ;
              rdfs:comment "A dataset series of which the dataset is part."@en ,
                           "Normally, child datasets in dataset series are represented as dcat:Dataset. The use of dcat:Distribution for typing child datasets is however recognized as a possible alternative, whenever it addresses more effectively the requirements of a given application scenario."@en ;
              rdfs:isDefinedBy dcat: ;
              rdfs:label "in Serie"@de ,
                         "in series"@en ;
              skos:editorialNote "changed by m4i: changed subproperty relation from DCTerms to OBO_000050 added rdfs:label, added German labels,  removed redundant notes, extracted from DCAT3-Documentation https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset_Series"@en .


###  http://www.w3.org/ns/dcat#mediaType
dcat:mediaType rdf:type owl:ObjectProperty ;
               rdfs:domain dcat:Distribution ;
               rdfs:comment "The media type of the distribution as defined by IANA."@en ;
               rdfs:isDefinedBy dcat: ;
               rdfs:label "Medientyp"@de ,
                          "media type"@en ;
               skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
               skos:scopeNote "This property SHOULD be used when the media type of the distribution is defined in the IANA media types registry https://www.iana.org/assignments/media-types/, otherwise dcterms:format MAY be used with different values."@en .


###  http://www.w3.org/ns/dcat#packageFormat
dcat:packageFormat rdf:type owl:ObjectProperty ;
                   rdfs:domain dcat:Distribution ;
                   rdfs:comment "The package format of the distribution in which one or more data files are grouped together, e.g. to enable a set of related files to be downloaded together."@en ;
                   rdfs:isDefinedBy dcat: ;
                   rdfs:label "Packformat"@de ,
                              "packaging format"@en ;
                   skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
                   skos:scopeNote "This property to be used when the files in the distribution are packaged, e.g. in a TAR file, a Frictionless Data Package or a Bagit file. The format SHOULD be expressed using a media type as defined by IANA media types registry https://www.iana.org/assignments/media-types/, if available."@en .


###  http://www.w3.org/ns/prov#agent
prov:agent rdf:type owl:ObjectProperty ;
           rdfs:range prov:Agent ;
           rdfs:comment "The prov:agent property is used to reference an agent that had a role in an activity."@en ;
           rdfs:label "has agent"@en ,
                      "hat Akteur"@de ;
           skos:editorialNote "changed by m4i: added German label, added rdfs:label"@en ,
                              "changed by m4i: simplified definition"@en .


###  http://www.w3.org/ns/prov#hadRole
prov:hadRole rdf:type owl:ObjectProperty ;
             owl:inverseOf prov:wasRoleIn ;
             rdfs:domain prov:Association ;
             rdfs:comment "prov:hadRole references the Role (i.e. the function of an entity with respect to an activity)"@en ;
             rdfs:label "had role"@en ,
                        "hatte Rolle"@de ;
             skos:editorialNote "changed by m4i: exchanged original rdfs:label by rdfs:label, added German label, simplified definition, simplified rdfs:domain to prov:Association"@en .


###  http://www.w3.org/ns/prov#qualifiedAssociation
prov:qualifiedAssociation rdf:type owl:ObjectProperty ;
                          rdfs:domain prov:Activity ;
                          rdfs:range prov:Association ;
                          rdfs:comment "Allows to specify more information (e.g. a role) about an association between an agent (e.g. a person) and an Activity (e.g. a processing step)."@en ,
                                       "Ermöglicht die Angabe weiterer Informationen (z.B. einer Rolle) zu einer Verknüpfung zwischen einem Agenten (z.B. einer Person) und einer Aktivität (z.B. einem Prozessschritt)."@de ;
                          rdfs:isDefinedBy prov: ;
                          rdfs:label "has qualified association"@en ,
                                     "hat qualifizierte Verbindung"@de ;
                          skos:editorialNote "changed by m4i: added German label, added rdfs:label, added rdfs:comment, skos:example and skos:note"@en ;
                          skos:example """Example application in m4i:
:SomeProcess
    a m4i:ProcessingStep;
    obo:RO_0000057 :SomePerson;
    prov:qualifiedAssociation [
        a prov:Association;
        prov:agent   :SomePerson;
        prov:hadRole :SomeRole;
    rdfs:comment \":SomePerson had the :SomeRole in this :SomeProcess\"@en
    ] .
The direct relation between an activity and an agent expressed with 'has participant' (http://purl.obolibrary.org/obo/RO_0000057 or http://www.w3.org/ns/prov#wasAssociatedWith) does not give details about the agent's role in that activity. Using the property prov:qualifiedAssociation one can point to a blank node (cf. https://en.wikipedia.org/w/index.php?title=Blank_node) containing additional information about the participation relation.
"""@en ;
                          skos:note "In metadata4ing use obo:RO_0000057 or prov:wasAssociatedWith as unqualified form for the relation between an activity and an agent."@en .


###  http://www.w3.org/ns/prov#wasAssociateFor
prov:wasAssociateFor rdf:type owl:ObjectProperty ;
                     owl:inverseOf prov:wasAssociatedWith ;
                     rdfs:comment "property between an agent and an activity with which the agent was associated with or participates in"@en ;
                     rdfs:label "ist beteiligt an"@de ,
                                "participates in"@en ;
                     skos:altLabel "wasAssociateFor"@en ;
                     skos:editorialNote "changed by m4i: exchanged original rdfs:label by rdfs:label, added German rdfs:label; added own rdfs:comment"@en .


###  http://www.w3.org/ns/prov#wasAssociatedWith
prov:wasAssociatedWith rdf:type owl:ObjectProperty ;
                       rdfs:domain prov:Activity ;
                       rdfs:range prov:Agent ;
                       owl:propertyChainAxiom ( prov:qualifiedAssociation
                                                prov:agent
                                              ) ;
                       rdfs:comment "property between some activity and an agent involved in that activity"@en ;
                       rdfs:label "has participant"@en ,
                                  "hat Teilnehmer"@de ;
                       skos:altLabel "wasAssociatedWith"@en ;
                       skos:editorialNote "changed by m4i: exchanged original rdfs:label by rdfs:label, moved original rdfs:label to skos:altLabel, added German rdfs:label; added own rdfs:comment"@en .


###  http://www.w3.org/ns/prov#wasGeneratedBy
prov:wasGeneratedBy rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasRoleIn
prov:wasRoleIn rdf:type owl:ObjectProperty ;
               rdfs:comment "prov:wasRoleIn references the association (e.g. between an agent and an activity) in which a role shall be defined. Inverse property of prov:hadRole." ;
               rdfs:label "war Rolle in"@de ,
                          "was role in"@en ;
               skos:editorialNote "changed by m4i: exchanged original rdfs:label by rdfs:label, added German label, added rdfs:comment, harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  http://www.w3.org/ns/ssn/hasProperty
ssn:hasProperty rdf:type owl:ObjectProperty ;
                owl:inverseOf ssn:isPropertyOf ;
                rdfs:comment "Relation between an entity and a Property of that entity."@en ;
                rdfs:isDefinedBy ssn: ;
                rdfs:label "has property"@en ,
                           "hat Eigenschaft"@de ;
                skos:editorialNote "changed by m4i: added rdfs:label, added German labels"@en .


###  http://www.w3.org/ns/ssn/implementedBy
ssn:implementedBy rdf:type owl:ObjectProperty ;
                  rdfs:comment "Beziehung zwischen einer Prozedur (einem Algorithmus, einer Prozedur oder einer Methode) und einer Entität, die diese Prozedur in einer ausführbaren Weise implementiert."@de ,
                               "Relation between a Procedure (an algorithm, procedure or method) and an entity that implements that Procedure in some executable way."@en ;
                  rdfs:label "implemented by"@en ,
                             "wird implementiert durch"@de ;
                  skos:editorialNote "changed by m4i: added rdfs:comment, added German definition"@en .


###  http://www.w3.org/ns/ssn/implements
ssn:implements rdf:type owl:ObjectProperty ;
               rdfs:comment "Beziehung zwischen einer Entität, die eine Prozedur in einer ausführbaren Weise implementiert, und der Prozedur (einem Algorithmus, einer Prozedur oder einer Methode)."@de ,
                            "Relation between an entity that implements a Procedure in some executable way and the Procedure (an algorithm, procedure or method)."@en ;
               rdfs:label "implementiert"@de ,
                          "implements"@en ;
               skos:editorialNote "changed by m4i: added rdfs:comment, added German definition"@en .


###  http://www.w3.org/ns/ssn/isPropertyOf
ssn:isPropertyOf rdf:type owl:ObjectProperty ;
                 rdfs:comment "Relation between a Property and the entity it belongs to."@en ;
                 rdfs:label "is property of"@en ,
                            "ist Eigenschaft von"@de ;
                 skos:editorialNote "changed by m4i: added rdfs:label, added German labels"@en .


###  http://xmlns.com/foaf/0.1/mbox
foaf:mbox rdf:type owl:ObjectProperty ,
                   owl:InverseFunctionalProperty ;
          rdfs:range owl:Thing ;
          rdfs:comment "A personal mailbox, ie. an Internet mailbox associated with exactly one owner, the first owner of this mailbox. This is a 'static inverse functional property', in that there is (across time and change) at most one individual that ever has any particular value for foaf:mbox." ;
          rdfs:isDefinedBy foaf: ;
          rdfs:label "E-Mail-Adresse"@de ,
                     "personal mailbox"@en ;
          skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  https://ptb.de/sis/hasMeasurementUncertaintyMultivariate
sis:hasMeasurementUncertaintyMultivariate rdf:type owl:ObjectProperty ;
                                          rdfs:subPropertyOf m4i:hasUncertaintyDeclaration ;
                                          owl:propertyDisjointWith sis:hasMeasurementUncertaintyUnivariate .


###  https://ptb.de/sis/hasMeasurementUncertaintyUnivariate
sis:hasMeasurementUncertaintyUnivariate rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf m4i:hasUncertaintyDeclaration .


###  https://schema.org/about
schema:about rdf:type owl:ObjectProperty .


###  https://schema.org/affiliation
schema:affiliation rdf:type owl:ObjectProperty ;
                   rdfs:comment "An organization that this person is affiliated with. For example, a school/university, a club, or a team."@en ,
                                "Eine Organisation, der eine Person angehört"@de ;
                   rdfs:label "Organisationszugehörigkeit"@de ,
                              "affiliation"@en ;
                   skos:editorialNote "changed by m4i: added German definition, added language tag to English definition"@en ,
                                      "changed by m4i: added German label, added language tag to English label, removed schema:rangeIncludes and schema:domainIncludes properties"@en ,
                                      "changed by m4i: added application example"@en ;
                   skos:example ":Person schema:affiliation :Organization ."@en .


###  https://schema.org/citation
schema:citation rdf:type owl:ObjectProperty ;
                rdfs:comment "A citation or reference to another creative work, such as another publication, web page, scholarly article, etc."@en ,
                             "Ein Verweis oder eine Referenz auf ein anderes kreatives Werk, wie beispielsweise eine andere Veröffentlichung, eine Webseite, einen wissenschaftlichen Artikel usw."@de ;
                rdfs:label "Zitation"@de ,
                           "citation"@en ;
                skos:editorialNote "changed by m4i: added German definition, added language tag to English definition"@en ,
                                   "changed by m4i: added German label, added language tag to English label, removed schema:rangeIncludes and schema:domainIncludes properties"@en ;
                skos:example ":Paper schema:citation :Dataset ."@en .


###  https://schema.org/funder
schema:funder rdf:type owl:ObjectProperty ;
              rdfs:comment "A person or organization that supports (sponsors) something through some kind of financial contribution."@en ,
                           "Eine Person oder Organisation, die etwas finanziell unterstützt"@de ;
              rdfs:label "Förderer"@de ,
                         "funder"@en ;
              skos:editorialNote "changed by m4i: added German definition, added language tag to English definition"@en ,
                                 "changed by m4i: added German label, added language tag to English label, removed schema:rangeIncludes and schema:domainIncludes properties"@en ,
                                 "changed by m4i: added application example"@en ;
              skos:example ":Project schema:funder :DFG"@en .


###  https://schema.org/image
schema:image rdf:type owl:ObjectProperty .


###  https://schema.org/instrument
schema:instrument rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf obo:RO_0000057 ;
                  rdfs:domain prov:Activity ;
                  rdfs:comment "points to an object that helped the agent perform the action (e.g., John wrote a book with a pen)"@en ;
                  rdfs:label "nutzt Instrument"@de ,
                             "uses instrument"@en ;
                  skos:editorialNote "changed by m4i: added different rdfs:label, added German label, removed schema:rangeIncludes and schema:domainIncludes properties"@en ,
                                     "changed by m4i: domain changed to prov:Activity from schema:Action"@en .


###  https://schema.org/logo
schema:logo rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf schema:image ;
            rdfs:comment "An associated logo."@en ,
                         "Ein zugehöriges Logo."@de ;
            rdfs:label "Logo"@de ,
                       "logo"@en ;
            skos:editorialNote "changed by m4i: added German definition, added language tag to English definition, removed schema:rangeIncludes and schema:domainIncludes properties"@en ,
                               "changed by m4i: added German label, added language tag to English label"@en .


###  https://schema.org/measurementTechnique
schema:measurementTechnique rdf:type owl:ObjectProperty .


###  https://schema.org/softwareRequirements
schema:softwareRequirements rdf:type owl:ObjectProperty .


###  https://schema.org/variableMeasured
schema:variableMeasured rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://w3id.org/nfdi4ing/metadata4ing#UsageInstruction
m4i:UsageInstruction rdf:type owl:DatatypeProperty ;
                     rdfs:domain m4i:ProcessingStep ;
                     rdfs:range [ rdf:type rdfs:Datatype ;
                                  owl:unionOf ( rdfs:Literal
                                                xsd:string
                                              )
                                ] ;
                     rdfs:comment "Textual description of a processing step within a research process to enable or facilitate its reproducibility"@en ,
                                  "Textuelle Beschreibung eines Verarbeitungsschritts innerhalb eines Forschungsprozesses, um dessen Reproduzierbarkeit zu erleichtern oder zu ermöglichen"@de ;
                     rdfs:label "Verwendungshinweis"@de ,
                                "usage instruction"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#endOfProject
m4i:endOfProject rdf:type owl:DatatypeProperty ;
                 rdfs:domain schema:Project ;
                 rdfs:range xsd:date ;
                 rdfs:comment "Projektenddatum"@de ,
                              "end date of a project"@en ;
                 rdfs:label "Projektenddatum"@de ,
                            "project end date"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasAssignmentTimestamp
m4i:hasAssignmentTimestamp rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf schema:temporal ;
                           rdfs:domain pims-ii:Assignment ;
                           rdfs:range schema:DateTime ;
                           rdfs:comment "Points to a timestamp associated with an assignment; there are multiple kinds of timestamp datatype properties, which are included here from schema.org"@en ;
                           rdfs:label "has assignment timestamp"@en ,
                                      "hat Zuweisungszeitstempel"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasBooleanValue
m4i:hasBooleanValue rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf m4i:hasValue ;
                    rdfs:domain m4i:BooleanVariable ;
                    rdfs:range xsd:boolean ;
                    rdfs:comment "A boolean value that can be true (expressed by 'true' or '1') or false (expressed by 'false' or '0')."@en ,
                                 "Ein Boolescher Wert, der wahr (ausgedruckt durch 'true' oder '1') oder falsch (ausgedrückt durch 'false' oder '0') sein kann."@de ;
                    rdfs:label "has boolean value"@en ,
                               "hat Booleschen Wert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasDateAssignmentCreated
m4i:hasDateAssignmentCreated rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf m4i:hasAssignmentTimestamp ;
                             rdfs:domain pims-ii:Assignment ;
                             rdfs:range schema:DateTime ;
                             rdfs:comment "Points to a date(time) of creation of an assignment"@en ;
                             rdfs:label "has date assignment created"@en ,
                                        "hat Datumszuweisung erzeugt"@de ;
                             skos:broader schema:dateCreated .


###  http://w3id.org/nfdi4ing/metadata4ing#hasDateAssignmentDeleted
m4i:hasDateAssignmentDeleted rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf m4i:hasAssignmentTimestamp ;
                             rdfs:domain pims-ii:Assignment ;
                             rdfs:range schema:DateTime ;
                             rdfs:comment "Points to a date(time) of deletion of an assignment"@en ;
                             rdfs:label "has date assignment deleted"@en ,
                                        "hat Datumszuweisung gelöscht"@de ;
                             skos:broader schema:dateDeleted .


###  http://w3id.org/nfdi4ing/metadata4ing#hasDateAssignmentModified
m4i:hasDateAssignmentModified rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf m4i:hasAssignmentTimestamp ;
                              rdfs:domain pims-ii:Assignment ;
                              rdfs:range schema:DateTime ;
                              rdfs:comment "Points to a date(time) of modification of an assignment"@en ;
                              rdfs:label "has date assignment modified"@en ,
                                         "hat Datumszuweisung bearbeitet"@de ;
                              skos:broader schema:dateModified .


###  http://w3id.org/nfdi4ing/metadata4ing#hasDateAssignmentValidFrom
m4i:hasDateAssignmentValidFrom rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf m4i:hasAssignmentTimestamp ;
                               rdfs:domain pims-ii:Assignment ;
                               rdfs:range schema:DateTime ;
                               rdfs:comment "Points to a date(time) at which the validity of an assignment begins"@en ;
                               rdfs:label "has date assignment valid from"@en ,
                                          "hat Datumszuweisung gültig ab"@de ;
                               skos:broader schema:validFrom .


###  http://w3id.org/nfdi4ing/metadata4ing#hasDateAssignmentValidUntil
m4i:hasDateAssignmentValidUntil rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf m4i:hasAssignmentTimestamp ;
                                rdfs:domain pims-ii:Assignment ;
                                rdfs:range schema:DateTime ;
                                rdfs:comment "Points to a date(time) at which the validity of an assignment ends"@en ;
                                rdfs:label "has date assignment valid until"@en ,
                                           "hat Datumszuweisung gültig bis"@de ;
                                skos:broader schema:validThrough .


###  http://w3id.org/nfdi4ing/metadata4ing#hasMaximumValue
m4i:hasMaximumValue rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf m4i:hasValue ;
                    rdfs:domain m4i:NumericalVariable ;
                    rdfs:range [ rdf:type rdfs:Datatype ;
                                 owl:unionOf ( xsd:decimal
                                               dcc:formulaType
                                             )
                               ] ;
                    rdfs:comment "Represents the highest value of a multi-valued variable"@en ;
                    rdfs:label "has maximum value"@en ,
                               "hat Maximalwert"@de ;
                    skos:broader qudt:value ,
                                 pims-ii:isLiterally ,
                                 sis:hasValue ;
                    skos:editorialNote "changed by m4i: updated skos:broader"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasMinimumValue
m4i:hasMinimumValue rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf m4i:hasValue ;
                    rdfs:domain m4i:NumericalVariable ;
                    rdfs:range [ rdf:type rdfs:Datatype ;
                                 owl:unionOf ( xsd:decimal
                                               dcc:formulaType
                                             )
                               ] ;
                    rdfs:comment "Represents the lowest value of a multi-valued variable"@en ;
                    rdfs:label "has minimum value"@en ,
                               "hat Minimalwert"@de ;
                    skos:broader qudt:value ,
                                 pims-ii:isLiterally ,
                                 sis:hasValue ;
                    skos:editorialNote "changed by m4i: updated skos:broader"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasNumericalValue
m4i:hasNumericalValue rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf m4i:hasValue ;
                      rdfs:domain m4i:NumericalVariable ;
                      rdfs:range [ rdf:type rdfs:Datatype ;
                                   owl:unionOf ( xsd:decimal
                                                 dcc:formulaType
                                               )
                                 ] ;
                      rdfs:comment "Represents the numerical value of a real"@en ;
                      rdfs:label "has numerical value"@en ,
                                 "hat Zahlenwert"@de ;
                      skos:broader qudt:value ,
                                   pims-ii:isLiterally ,
                                   sis:hasValue ;
                      skos:closeMatch sis:hasValue ;
                      skos:editorialNote "changed by m4i: updated skos:broader, skos:closeMatch"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasRorId
m4i:hasRorId rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf m4i:identifier ;
             rdfs:domain prov:Organization ;
             rdfs:range [ rdf:type rdfs:Datatype ;
                          owl:onDatatype xsd:string ;
                          owl:withRestrictions ( [ xsd:pattern "https://ror.org/[0-9][0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][a-z0-9][0-9][0-9]"
                                                 ]
                                               )
                        ] ;
             rdfs:comment "A Research Organization Registry identifier that persistently and uniquely identifies a research organization"@en ,
                          "Ein persistenter Identifikator für Organisationen, vergeben durch die Research Organization Registry, der eine Forschungseinrichtung eindeutig identifiziert."@de ;
             rdfs:label "has ROR ID"@en ,
                        "hat ROR ID"@de ;
             skos:altLabel "has research organization registry id"@en ,
                           "hat Forschungsorganisationsid"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasStepSize
m4i:hasStepSize rdf:type owl:DatatypeProperty ;
                rdfs:subPropertyOf m4i:hasValue ;
                rdfs:domain m4i:NumericalVariable ;
                rdfs:range [ rdf:type rdfs:Datatype ;
                             owl:unionOf ( xsd:decimal
                                           dcc:formulaType
                                         )
                           ] ;
                rdfs:comment "Describes the spacing of a multi-valued variable"@en ;
                rdfs:label "has step size"@en ,
                           "hat Schrittweite"@de ;
                skos:broader qudt:value ,
                             pims-ii:isLiterally ,
                             sis:hasValue ;
                skos:editorialNote "changed by m4i: updated skos:broader"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#hasStringValue
m4i:hasStringValue rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf m4i:hasValue ;
                   rdfs:domain m4i:TextVariable ;
                   rdfs:range xsd:string ;
                   rdfs:comment "A character string of any length"@en ,
                                "Eine Zeichenkette (Text) beliebiger Länge."@de ;
                   rdfs:label "has string value"@en ,
                              "hat Zeichenwert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasSymbol
m4i:hasSymbol rdf:type owl:DatatypeProperty ;
              rdfs:domain pims-ii:Variable ;
              rdfs:range xsd:string ;
              rdfs:comment "Buchstabe oder Zeichenkette, die eine Variable repräsentiert"@de ,
                           "Letter or string that denotes a variable"@en ;
              rdfs:label "has symbol"@en ,
                         "hat Symbol"@de ;
              skos:broader qudt:symbol .


###  http://w3id.org/nfdi4ing/metadata4ing#hasValue
m4i:hasValue rdf:type owl:DatatypeProperty ;
             rdfs:domain pims-ii:Variable ;
             rdfs:comment "A value of any type"@en ,
                          "Ein beliebiger Wert"@de ;
             rdfs:label "has value"@en ,
                        "hat Wert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#hasVariableDescription
m4i:hasVariableDescription rdf:type owl:DatatypeProperty ;
                           rdfs:domain pims-ii:Variable ;
                           rdfs:range xsd:string ;
                           rdfs:comment "Textual and human readable description of a variable in a research context"@en ,
                                        "Textuelle und menschenlesbare Beschreibung einer Variablen im Forschungskontext"@de ;
                           rdfs:label "has variable description"@en ,
                                      "hat Variablenbeschreibung"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#identifier
m4i:identifier rdf:type owl:DatatypeProperty ;
               rdfs:domain owl:Thing ;
               rdfs:range xsd:string ;
               rdfs:comment "A systematically built alphanumeric string that identifies a unique object (e.g. a person, a publication, an organisation, a research activity, a sample, etc.) or a unique class of objects."@en ;
               rdfs:label "has identifier"@en ,
                          "hat Identifikator"@de ;
               skos:altLabel "besitzt eindeutigen Identifikator"@de ,
                             "has unique identifier"@en ,
                             "is represented through identifier"@en ,
                             "wird durch Identifikator repräsentiert"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#orcidId
m4i:orcidId rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf m4i:identifier ;
            rdfs:domain prov:Person ;
            rdfs:range [ rdf:type rdfs:Datatype ;
                         owl:onDatatype xsd:string ;
                         owl:withRestrictions ( [ xsd:pattern "https://orcid.org/[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9X]"
                                                ]
                                              )
                       ] ;
            rdfs:comment "Open Researcher and Contributor ID: an identifier, that allows unique identification of a person, usually active in research."@en ,
                         "Open Researcher and Contributor ID: ein persistenter Identifikator, der eine in der Forschung tätige Person eindeutig identifiziert."@de ;
            rdfs:label "has ORCID ID"@en ,
                       "hat ORCID ID"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#projectReferenceID
m4i:projectReferenceID rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf m4i:identifier ;
                       rdfs:domain schema:Project ;
                       rdfs:range xsd:string ;
                       rdfs:comment "An alphanumeric identifier for a project. We recommend using an identifier which is understandable outside the involved institutions and possibly resolvable and persistent, such as the [Research Activity Identifier (RAiD)](https://raid.org/) or a funder-given ID (see for example the [DFG project database](https://gepris.dfg.de/gepris/OCTOPUS) or the [EU project database](https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/projects-results))."@en ,
                                    "Eine alphanumerische ID zur Referenzierung eines Projekts. Wir empfehlen die Nutzung einer auch außerhalb der teilnehmenden Institutionen verständlichen ID, am besten persistent und mit einem Resolving-System verknüpft, wie bspw. die [Research Activity Identifier (RAiD)](https://raid.org/) oder eine von einem Förderer zugewiesene ID (siehe bspw. die [DFG-Projektendatenbank](https://gepris.dfg.de/gepris/OCTOPUS) oder die [EU-Projektendatenbank](https://ec.europa.eu/info/funding-tenders/opportunities/portal/screen/opportunities/projects-results))."@de ;
                       rdfs:label "has project ID"@en ,
                                  "hat Projekt-ID"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#startOfProject
m4i:startOfProject rdf:type owl:DatatypeProperty ;
                   rdfs:domain schema:Project ;
                   rdfs:range xsd:date ;
                   rdfs:comment "Startdatum eines Projekts"@de ,
                                "start date of a project"@en ;
                   rdfs:label "Projektstartdatum"@de ,
                              "project start date"@en .


###  http://www.w3.org/ns/dcat#byteSize
dcat:byteSize rdf:type owl:DatatypeProperty ;
              rdfs:domain dcat:Distribution ;
              rdfs:comment "The size of a distribution in bytes."@en ;
              rdfs:isDefinedBy dcat: ;
              rdfs:label "Dateigröße (in Byte)"@de ,
                         "file size (in bytes)"@en ;
              skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
              skos:scopeNote "The size in bytes can be approximated when the precise size is not known. The literal value of dcat:byteSize should by typed as xsd:decimal."@en .


###  http://www.w3.org/ns/dcat#spatialResolutionInMeters
dcat:spatialResolutionInMeters rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:decimal ;
                               rdfs:comment "Minimum spatial separation resolvable in a dataset, measured in metres."@en ;
                               rdfs:label "räumliche Auflösung (in Metern)"@de ,
                                          "spatial resolution (in metres)"@en ;
                               skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition, adjusted spelling conform to SI"@en ;
                               skos:scopeNote "Alternative spatial resolutions might be provided as different dataset distributions."@en ,
                                              "If the dataset is an image or grid this should correspond to the spacing of items. For other kinds of spatial dataset, this property will usually indicate the smallest distance between items in the dataset."@en .


###  http://www.w3.org/ns/dcat#temporalResolution
dcat:temporalResolution rdf:type owl:DatatypeProperty ;
                        rdfs:range xsd:duration ;
                        rdfs:comment "Minimum time period resolvable in a dataset."@en ;
                        rdfs:label "temporal resolution"@en ,
                                   "zeitliche Auflösung"@de ;
                        skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
                        skos:scopeNote "Alternative temporal resolutions might be provided as different dataset distributions."@en ,
                                       "If the dataset is a time-series this should correspond to the spacing of items in the series. For other kinds of dataset, this property will usually indicate the smallest time difference between items in the dataset."@en .


###  http://xmlns.com/foaf/0.1/firstName
foaf:firstName rdf:type owl:DatatypeProperty ;
               rdfs:range rdfs:Literal ;
               rdfs:comment "The first name of a person." ;
               rdfs:label "Vorname"@de ,
                          "first name"@en ;
               skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  http://xmlns.com/foaf/0.1/lastName
foaf:lastName rdf:type owl:DatatypeProperty ;
              rdfs:range rdfs:Literal ;
              rdfs:comment "The last name of a person." ;
              rdfs:label "Nachname"@de ,
                         "last name"@en ;
              skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  http://xmlns.com/foaf/0.1/title
foaf:title rdf:type owl:DatatypeProperty ;
           rdfs:range rdfs:Literal ;
           rdfs:comment "Title (Mr, Mrs, Ms, Dr. etc)" ;
           rdfs:label "Anrede"@de ,
                      "salutation"@en ;
           skos:editorialNote "changed by m4i: added German labels, added rdfs:label, defined rdfs:domain and rdfs:range"@en .


###  https://ptb.de/si/hasCoverageFactor
six:hasCoverageFactor rdf:type owl:DatatypeProperty ;
                      rdfs:domain six:ExpandedUnc ;
                      rdfs:range [ rdf:type rdfs:Datatype ;
                                   owl:onDatatype xsd:decimal ;
                                   owl:withRestrictions ( [ xsd:minInclusive 1.0
                                                          ]
                                                        )
                                 ] ;
                      obo:IAO_0000231 obo:IAO_000028 ;
                      obo:IAO_0100001 sis:hasCoverageFactor ;
                      rdfs:comment "OBSOLETE. Points to the coverage factor, i.e., to a factor (greater than or equal to unity) by which the expanded uncertainty relates to the standard uncertainty"@en ;
                      rdfs:label "obsolet hat Überdeckungsfaktor"@de ,
                                 "obsolete has coverage factor"@en ;
                      owl:deprecated "true"^^xsd:boolean ;
                      skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:hasCoverageFactor"@en ,
                                         "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://ptb.de/si/hasCoverageProbability
six:hasCoverageProbability rdf:type owl:DatatypeProperty ;
                           rdfs:domain m4i:UncertaintyDeclaration ;
                           rdfs:range [ rdf:type rdfs:Datatype ;
                                        owl:onDatatype xsd:decimal ;
                                        owl:withRestrictions ( [ xsd:minInclusive 0.0
                                                               ]
                                                               [ xsd:maxInclusive 1.0
                                                               ]
                                                             )
                                      ] ;
                           obo:IAO_0000231 obo:IAO_000028 ;
                           obo:IAO_0100001 sis:hasCoverageProbability ;
                           rdfs:comment "OBSOLETE. Points to the probability (between 0 and 1) ascribed to the event of the actual value falling within the range asserted by the given uncertainty declaration"@en ;
                           rdfs:label "obsolet hat Deckungswahrscheinlichkeit"@de ,
                                      "obsolete has coverage probability"@en ;
                           owl:deprecated "true"^^xsd:boolean ;
                           skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:hasCoverageProbability"@en ,
                                              "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://ptb.de/si/hasDistribution
six:hasDistribution rdf:type owl:DatatypeProperty ;
                    rdfs:domain m4i:UncertaintyDeclaration ;
                    rdfs:range xsd:string ;
                    obo:IAO_0000231 obo:IAO_000028 ;
                    obo:IAO_0100001 sis:hasDistribution ;
                    rdfs:comment "OBSOLETE. Points to a descriptor/label of the assumed underlying distribution"@en ;
                    rdfs:label "obsolet hat statistische Verteilung"@de ,
                               "obsolete has statistical distribution"@en ;
                    owl:deprecated "true"^^xsd:boolean ;
                    skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:hasDistribution"@en ,
                                       "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://ptb.de/si/hasIntervalMax
six:hasIntervalMax rdf:type owl:DatatypeProperty ;
                   rdfs:domain six:CoverageInterval ;
                   rdfs:range xsd:decimal ;
                   obo:IAO_0000231 obo:IAO_000028 ;
                   obo:IAO_0100001 sis:hasIntervalMax ;
                   rdfs:comment "OBSOLETE. Upper boundary of the coverage interval"@en ;
                   rdfs:label "obsolet hat Intervallmaximum"@de ,
                              "obsolete has interval maximum"@en ;
                   owl:deprecated "true"^^xsd:boolean ;
                   skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:hasIntervalMax"@en ,
                                      "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://ptb.de/si/hasIntervalMin
six:hasIntervalMin rdf:type owl:DatatypeProperty ;
                   rdfs:domain six:CoverageInterval ;
                   rdfs:range xsd:decimal ;
                   obo:IAO_0000231 obo:IAO_000028 ;
                   obo:IAO_0100001 sis:hasIntervalMin ;
                   rdfs:comment "OBSOLETE. Lower boundary of the coverage interval"@en ;
                   rdfs:label "obsolet hat Intervallminimum"@de ,
                              "obsolete has interval minimum"@en ;
                   owl:deprecated "true"^^xsd:boolean ;
                   skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:hasIntervalMin"@en ,
                                      "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://ptb.de/si/hasStandardUnc
six:hasStandardUnc rdf:type owl:DatatypeProperty ;
                   rdfs:domain six:CoverageInterval ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 0.0
                                                       ]
                                                     )
                              ] ;
                   obo:IAO_0000231 obo:IAO_000028 ;
                   obo:IAO_0100001 sis:hasValueStandardMU ;
                   rdfs:comment "OBSOLETE. The standard measurement uncertainty is the measurement uncertainty expressed as a standard deviation"@en ;
                   rdfs:label "obsolet hat Standardunsicherheit"@de ,
                              "obsolete has standard uncertainty"@en ;
                   owl:deprecated "true"^^xsd:boolean ;
                   skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:hasValueStandardMU"@en ,
                                      "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://ptb.de/si/hasUncertainty
six:hasUncertainty rdf:type owl:DatatypeProperty ;
                   rdfs:domain six:ExpandedUnc ;
                   rdfs:range [ rdf:type rdfs:Datatype ;
                                owl:onDatatype xsd:decimal ;
                                owl:withRestrictions ( [ xsd:minInclusive 0.0
                                                       ]
                                                     )
                              ] ;
                   obo:IAO_0000231 obo:IAO_000028 ;
                   obo:IAO_0100001 sis:hasMeasurementUncertainty ;
                   rdfs:comment "OBSOLETE. Absolute magnitude of the indicated uncertainty"@en ;
                   rdfs:label "obsolet hat Unsicherheit"@de ,
                              "obsolete has uncertainty"@en ;
                   owl:deprecated "true"^^xsd:boolean ;
                   skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:hasMeasurementUncertainty"@en ,
                                      "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://schema.org/endTime
schema:endTime rdf:type owl:DatatypeProperty ;
               rdfs:domain m4i:ProcessingStep ;
               rdfs:range schema:DateTime ;
               rdfs:comment """The endTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to end. For actions that span a period of time, when the action was performed. e.g. John wrote a book from January to <em>December</em>. For media, including audio and video, it's the time offset of the end of a clip within a larger file.<br/><br/>

Note that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions."""@en ;
               rdfs:isDefinedBy schema: ;
               rdfs:label "Endzeit"@de ,
                          "end time"@en ;
               skos:editorialNote "changed by m4i: added rdfs:label, added German label"@en .


###  https://schema.org/startTime
schema:startTime rdf:type owl:DatatypeProperty ;
                 rdfs:domain m4i:ProcessingStep ;
                 rdfs:range schema:DateTime ;
                 rdfs:comment """The startTime of something. For a reserved event or service (e.g. FoodEstablishmentReservation), the time that it is expected to start. For actions that span a period of time, when the action was performed. e.g. John wrote a book from <em>January</em> to December. For media, including audio and video, it's the time offset of the start of a clip within a larger file.<br/><br/>

Note that Event uses startDate/endDate instead of startTime/endTime, even when describing dates with times. This situation may be clarified in future revisions."""@en ;
                 rdfs:isDefinedBy schema: ;
                 rdfs:label "Startzeit"@de ,
                            "start time"@en ;
                 skos:editorialNote "changed by m4i: added rdfs:label, added German label"@en .


###  https://schema.org/temporal
schema:temporal rdf:type owl:DatatypeProperty ;
                rdfs:range schema:DateTime ;
                rdfs:comment "The 'temporal' property can be used in cases where more specific properties (e.g., dateCreated, dateModified, datePublished) are not known to be appropriate"@en ;
                rdfs:label "has timestamp"@en ,
                           "hat Zeitstempel"@de ;
                skos:editorialNote "changed by m4i: added different rdfs:label, added German label"@en .


#################################################################
#    Classes
#################################################################

###  http://mlcommons.org/croissant/Field
cr:Field rdf:type owl:Class ;
         rdfs:subClassOf schema:Intangible ;
         rdfs:comment "A component of the structure of a RecordSet, such as a column of a table."@en ,
                      "Ein Bestandteil der Struktur eines RecordSets wie z.B. eine Spalte einer Tabelle"@de ;
         rdfs:label "Feld"@de ,
                    "field"@en ;
         skos:editorialNote "changed by m4i: added German labels, added rdfs:label and rdfs:comment"@en .


###  http://mlcommons.org/croissant/FileObject
cr:FileObject rdf:type owl:Class ;
              rdfs:subClassOf schema:CreativeWork ;
              rdfs:comment "An individual file that is part of a dataset."@en ,
                           "Eine Einzeldatei, die Teil eines Datensatzes ist."@de ;
              rdfs:label "Dateiobject"@de ,
                         "file object"@en ;
              skos:editorialNote "changed by m4i: added German labels, added rdfs:label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  http://mlcommons.org/croissant/FileSet
cr:FileSet rdf:type owl:Class ;
           rdfs:subClassOf schema:Intangible ;
           rdfs:comment "A set of homogeneous files extracted from a container, optionally filtered by inclusion and/or exclusion filters."@en ,
                        "Ein Satz homogener Dateien, die aus einem Container extrahiert wurden, optional gefiltert durch Einschluss- und/oder Ausschlussfilter."@de ;
           rdfs:label "Dateimenge"@de ,
                      "file set"@en ;
           skos:editorialNote "changed by m4i: added German labels, added rdfs:label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  http://mlcommons.org/croissant/RecordSet
cr:RecordSet rdf:type owl:Class ;
             rdfs:subClassOf schema:Intangible ;
             rdfs:comment "A description of a set of structured records from one or more data sources and their structure, expressed as a set of fields."@en ,
                          "Eine Beschreibung einer Menge strukturierter Einträge von einer oder mehrerer Datenquellen mit ihrer Struktur, ausgedrückt durch eine Menge von Feldern"@de ;
             rdfs:label "Menge von Einträgen"@de ,
                        "record set"@en ;
             skos:editorialNote "changed by m4i: added German labels, added rdfs:label and rdfs:comment, harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  http://purl.obolibrary.org/obo/BFO_0000015
obo:BFO_0000015 rdf:type owl:Class ;
                rdfs:comment "Process, i.e., a physical entity with a temporal evolution that 'has a meaning for the ontologist'"@en ;
                rdfs:label "Prozess"@de ,
                           "process"@en ;
                skos:closeMatch pims-ii:Process ;
                skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  http://purl.obolibrary.org/obo/BFO_0000017
obo:BFO_0000017 rdf:type owl:Class ;
                rdfs:comment "To say that b is a realizable entity is to say that b is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region and is of a type instances of which are realized in processes of a correlated type. (axiom label in BFO2 Reference: [058-002])" ;
                rdfs:label "realisierbare Entität"@de ,
                           "realizable entity"@en ;
                skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  http://purl.org/spar/biro/BibliographicRecord
biro:BibliographicRecord rdf:type owl:Class ;
                         rdfs:comment "A record that uniquely describes a particular textual or data publication (or a work in preparation for publication). Each bibliographic record is a set of entities describing aspects of the referenced work, including, for example, but not restricted to: authors, title, journal, publication year, DOI, ISSN, publisher and copyright information, or, in the case of a data publication: creators, title, version, archive, publication year, DOI or other identifier). The FRBR expression of a bibliographic record is a bibliographic reference, which usually contains only a sub-set of these entities, ordered in a particular way that corresponds to the house style of the publication in which it occurs."@en ;
                         rdfs:label "bibliografischer Eintrag"@de ,
                                    "bibliographic record"@en ;
                         skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en .


###  http://qudt.org/schema/qudt/QuantityKind
qudt:QuantityKind rdf:type owl:Class ;
                  rdfs:subClassOf schema:Intangible ;
                  rdfs:comment "A <b>Quantity Kind</b> is any observable property that can be  measured and quantified numerically. Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. Less familiar examples include currency, interest rate, price to earning ratio, and information capacity."@en ;
                  rdfs:label "Größenart"@de ,
                             "quantity kind"@en ;
                  skos:editorialNote "changed by m4i: added German labels, added rdfs:label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
                  skos:note "we recommend using a persistent identifier resolving to a persistent URL"@en ;
                  skos:scopeNote "Kind of quantity, i.e., a physical/chemical quantity from a controlled vocabulary, such as QUDT, IEC, or EMMO"@en .


###  http://qudt.org/schema/qudt/Unit
qudt:Unit rdf:type owl:Class .


###  http://si-digital-framework.org/SI#MeasurementUnit
sirp:MeasurementUnit rdf:type owl:Class .


###  http://si-digital-framework.org/SI#QuantityKind
sirp:QuantityKind rdf:type owl:Class .


###  http://w3id.org/nfdi4ing/metadata4ing#BooleanVariable
m4i:BooleanVariable rdf:type owl:Class ;
                    rdfs:subClassOf pims-ii:Variable ;
                    rdfs:comment "A binary variable that expects as a value either true or false."@en ,
                                 "Eine binäre Variable, die als Wert entweder wahr oder falsch erwartet."@de ;
                    rdfs:label "Boolesche Variable"@de ,
                               "boolean variable"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#Configuration
m4i:Configuration rdf:type owl:Class ;
                  rdfs:comment "Configuration of a tool or a method in form of a set of parameters that is used in a research process."@en ,
                               "Konfiguration einer Methode oder eines Werkzeugs durch eine Menge von Parametern, die in einem Prozessschritt genutzt wird."@de ;
                  rdfs:label "Konfiguration"@de ,
                             "configuration"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#Method
m4i:Method rdf:type owl:Class ;
           rdfs:subClassOf obo:BFO_0000017 ;
           rdfs:comment "Abstract description of a method for analysis, generation and transformation of data and material objects like, e.g., 'Fourier Transform Infrared Spectroscopy' or 'Molecular Dynamics Simulation'. Note that while values for relevant parameters should be provided, m4i:Method does not refer to the actual execution of the process that is described (use m4i:ProcessingStep for that), but rather a description of the underlying principle."@en ;
           rdfs:label "Methode"@de ,
                      "method"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#NumericalAssignment
m4i:NumericalAssignment rdf:type owl:Class ;
                        rdfs:subClassOf pims-ii:Assignment ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty [ owl:inverseOf pims-ii:isValueInAssignment
                                                         ] ;
                                          owl:someValuesFrom sis:Real
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty [ owl:inverseOf pims-ii:isVariableInAssignment
                                                         ] ;
                                          owl:minCardinality "1"^^xsd:nonNegativeInteger
                                        ] ;
                        rdfs:comment "Assignment by which a variable (e.g., a physical property) is assigned a quantity value (scalar x measurement unit) in some context (e.g., applied to some object of research)"@en ;
                        rdfs:label "numerical assignment"@en ,
                                   "numerische Zuweisung"@de ;
                        skos:editorialNote "changed by m4i: updated rdfs:subClassOf, rdfs:comment"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#NumericalVariable
m4i:NumericalVariable rdf:type owl:Class ;
                      rdfs:subClassOf pims-ii:Variable ;
                      rdfs:comment "A variable that expects a float or integer as a value"@en ,
                                   "Eine Variable, die eine Zahl als Wert erwartet"@de ;
                      rdfs:label "numerical variable"@en ,
                                 "numerische Variable"@de ;
                      skos:closeMatch qudt:Quantity ,
                                      sis:QuantityValue ;
                      skos:editorialNote "changed by m4i: updated rdfs:subClassOf, skos:closeMatch"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#ProcessingStep
m4i:ProcessingStep rdf:type owl:Class ;
                   rdfs:subClassOf prov:Activity ;
                   rdfs:comment "Specific action undertaken during research"@en ;
                   rdfs:label "Arbeitsschritt"@de ,
                              "processing step"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#TextVariable
m4i:TextVariable rdf:type owl:Class ;
                 rdfs:subClassOf pims-ii:Variable ;
                 rdfs:comment "A variable that expects a string of characters as a value"@en ,
                              "Eine Variable, die eine Zeichenkette als Wert erwartet"@de ;
                 rdfs:label "text variable"@en ,
                            "textbasierte Variable"@de .


###  http://w3id.org/nfdi4ing/metadata4ing#Tool
m4i:Tool rdf:type owl:Class ;
         rdfs:comment "Object that helps an agent perform an action (e.g., John wrote a book with a pen), i.e., an object of the relation schema:instrument or m4i:hasTool"@en ;
         rdfs:label "Werkzeug"@de ,
                    "tool"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#UncertaintyDeclaration
m4i:UncertaintyDeclaration rdf:type owl:Class ;
                           rdfs:subClassOf schema:Intangible ;
                           obo:IAO_0000231 obo:IAO_000028 ;
                           obo:IAO_0100001 sis:MeasurementUncertainty ;
                           rdfs:comment "OBSOLETE. Declaration that can be applied to an six:Real quantity value to give an assessment of uncertainty"@en ;
                           rdfs:label "obsolet Unsicherheitsdeklaration"@de ,
                                      "obsolete uncertainty declaration"@en ;
                           owl:deprecated "true"^^xsd:boolean ;
                           skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:MeasurementUncertainty"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#Variable
m4i:Variable rdf:type owl:Class ;
             rdfs:label "Variable"@de ,
                        "variable"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#VariableSet
m4i:VariableSet rdf:type owl:Class ;
                rdfs:comment "A set of variables belonging together, which can be of same or different types (numerical, text or boolean)."@en ,
                             "Eine Menge zusammengehörender Variablen, die vom gleichen oder von unterschiedlichen Typen (numerisch, textbasiert oder boolsch) sein können."@de ;
                rdfs:label "Variablenmenge"@de ,
                           "variable set"@en .


###  http://www.molmod.info/semantics/pims-ii.ttl#Assignment
pims-ii:Assignment rdf:type owl:Class ;
                   rdfs:subClassOf schema:Intangible ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty [ owl:inverseOf pims-ii:isValueInAssignment
                                                    ] ;
                                     owl:someValuesFrom pims-ii:Value
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty [ owl:inverseOf pims-ii:isVariableInAssignment
                                                    ] ;
                                     owl:someValuesFrom pims-ii:Variable
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty pims-ii:isAssignmentFor ;
                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                   ] ;
                   rdfs:comment "Assignment, i.e., a data item by which a value is assigned to a variable with respect to a particular referent (e.g., T = 200 K for substance o as it was measured in a particular cognitive step); therein, T is the variable, related to the assignment by m4i:hasVariable, 200 K is the value, related to the assignment by m4i:hasValue, and o is the referent, related to the assignment by isAssignmentFor"@en ;
                   rdfs:label "Zuweisung"@de ,
                              "assignment"@en ;
                   skos:editorialNote "changed by m4i: added rdfs:label, adjusted German labels,  harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.molmod.info/semantics/pims-ii.ttl#Property
pims-ii:Property rdf:type owl:Class ;
                 rdfs:subClassOf pims-ii:Variable ;
                 rdfs:comment "Property, i.e., a variable that can be considered (as an investigated property, i.e., target property) within a processing step"@en ;
                 rdfs:label "Eigenschaft"@de ,
                            "property"@en ;
                 skos:broader obo:BFO_0000020 ;
                 skos:closeMatch emmo:EMMO_b7bcff25_ffc3_474e_9ab5_01b1664bd4ba ;
                 skos:editorialNote "changed by m4i: added rdfs:label, adjusted German labels, harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.molmod.info/semantics/pims-ii.ttl#QuantityValue
pims-ii:QuantityValue rdf:type owl:Class ;
                      rdfs:subClassOf pims-ii:Value ;
                      rdfs:comment "Quantity value, i.e., a value that has a numerical magnitude and a physical unit"@en ;
                      rdfs:label "Größenwert"@de ,
                                 "quantity value"@en ;
                      skos:editorialNote "changed by m4i: added rdfs:label, adjusted German labels, harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.molmod.info/semantics/pims-ii.ttl#Value
pims-ii:Value rdf:type owl:Class ;
              rdfs:subClassOf schema:Intangible ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty pims-ii:isAdmissibleValueFor ;
                                owl:minCardinality "1"^^xsd:nonNegativeInteger
                              ] ;
              rdfs:comment "Value, i.e., an articulation that is by social convention understood to be potentially assignable to a variable"@en ;
              rdfs:label "Wert"@de ,
                         "value"@en ;
              skos:editorialNote "changed by m4i: added rdfs:label, adjusted German labels, harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.molmod.info/semantics/pims-ii.ttl#Variable
pims-ii:Variable rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Restriction ;
                                       owl:onProperty [ owl:inverseOf pims-ii:isAdmissibleValueFor
                                                      ] ;
                                       owl:someValuesFrom pims-ii:Value
                                     ] ;
                 rdfs:subClassOf schema:Intangible ;
                 rdfs:comment "Variable, i.e., a conventional that is employed for something to which values can be assigned (this may include different notations for the same variable including, e.g., computational representations); this is to be understood very generally, e.g., a variable may be an array or set of elements or have another kind of internal structure"@en ;
                 rdfs:label "Variable"@de ,
                            "variable"@en ;
                 skos:closeMatch emmo:EMMO_1eed0732_e3f1_4b2c_a9c4_b4e75eeb5895 ;
                 skos:editorialNote "changed by m4i: added rdfs:label, adjusted German labels, harmonized spelling to OBO naming conventions (lower case, space separated)" .


###  http://www.w3.org/ns/dcat#Dataset
dcat:Dataset rdf:type owl:Class ;
             owl:equivalentClass schema:Dataset ;
             rdfs:comment "A collection of data, published or curated by a single source, and available for access or download in one or more representations."@en ;
             rdfs:isDefinedBy dcat: ;
             rdfs:label "Datensatz"@de ,
                        "dataset"@en ;
             skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en ;
             skos:scopeNote "The notion of dataset in DCAT is broad and inclusive, with the intention of accommodating resource types arising from all communities. Data comes in many forms including numbers, text, pixels, imagery, sound and other multi-media, and potentially other types, any of which might be collected into a dataset."@en ,
                            "This class describes the conceptual dataset. One or more representations might be available, with differing schematic layouts and formats or serializations."@en .


###  http://www.w3.org/ns/dcat#DatasetSeries
dcat:DatasetSeries rdf:type owl:Class ;
                   rdfs:subClassOf dcat:Dataset ;
                   rdfs:comment "A collection of datasets that are published separately, but share some common characteristics that groups them."@en ;
                   rdfs:isDefinedBy dcat: ;
                   rdfs:label "Datensatzserie"@de ,
                              "dataset series"@en ;
                   skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, extracted from DCAT3-Documentation https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset_Series"@en .


###  http://www.w3.org/ns/dcat#Distribution
dcat:Distribution rdf:type owl:Class ;
                  rdfs:comment "A specific representation of a dataset. A dataset might be available in multiple serializations that may differ in various ways, including natural language, media-type or format, schematic organization, temporal and spatial resolution, level of detail or profiles (which might specify any or all of the above)."@en ;
                  rdfs:isDefinedBy dcat: ;
                  rdfs:label "Verteilung"@de ,
                             "distribution"@en ;
                  skos:editorialNote "changed by m4i: added rdfs:label, added German labels, removed redundant notes, removed other languages than english in comment, label, changeNote and definition"@en .


###  http://www.w3.org/ns/prov#Activity
prov:Activity rdf:type owl:Class ;
              rdfs:subClassOf obo:BFO_0000015 ;
              rdfs:comment "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities."@en ,
                           "Eine Aktivität ist etwas, das über einen Zeitraum und mit oder an Entitäten erfolgt; dazu kann das Verbrauchen, Verarbeiten, Transformieren, Modifizieren, Relokalisieren, Verwenden, oder die Genese von Entitäten gehören."@de ;
              rdfs:label "Aktivität"@de ,
                         "activity"@en ;
              skos:closeMatch pims-ii:Action ;
              skos:editorialNote "changed by m4i: added rdfs:label, added German label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  http://www.w3.org/ns/prov#Agent
prov:Agent rdf:type owl:Class ;
           rdfs:comment "An agent is something that bears some form of responsibility for an activity taking place, for the existence of an entity, or for another agent's activity."@en ;
           rdfs:isDefinedBy prov: ;
           rdfs:label "Akteur"@de ,
                      "agent"@en ;
           skos:editorialNote "changed by m4i: added German labels, added rdfs:label, added rdfs:comment, added German definition, added instances"@en .


###  http://www.w3.org/ns/prov#Association
prov:Association rdf:type owl:Class ;
                 rdfs:comment "An instance of prov:Association provides additional descriptions about the binary prov:wasAssociatedWith relation from an prov:Activity to some prov:Agent that had some responsiblity for it. For example, :baking prov:wasAssociatedWith :baker; prov:qualifiedssociation [ a prov:Association; prov:agent :baker; :foo :bar ]."@en ;
                 rdfs:label "Verknüpfung"@de ,
                            "association"@en ;
                 skos:editorialNote "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  http://www.w3.org/ns/prov#Organization
prov:Organization rdf:type owl:Class ;
                  rdfs:subClassOf prov:Agent ;
                  rdfs:comment "An organization is a social or legal institution such as a company, society, etc."@en ,
                               "Eine Organisation ist eine soziale oder rechtliche Institution wie ein Unternehmen, ein Verein usw."@de ;
                  rdfs:isDefinedBy prov: ;
                  rdfs:label "Organisation"@de ,
                             "organization"@en ;
                  skos:editorialNote "changed by m4i: added German labels, added rdfs:label, added rdfs:comment, added German definition, added instances"@en .


###  http://www.w3.org/ns/prov#Person
prov:Person rdf:type owl:Class ;
            rdfs:subClassOf prov:Agent ;
            rdfs:comment "Eine Person als Akteur ist eine natürliche Person, also ein handelnder Mensch."@de ,
                         "Person agents are people."@en ;
            rdfs:isDefinedBy prov: ;
            rdfs:label "Person"@de ,
                       "person"@en ;
            skos:editorialNote "changed by m4i: added German labels, added rdfs:label, added rdfs:comment, added German definition, added instances"@en .


###  http://www.w3.org/ns/prov#Role
prov:Role rdf:type owl:Class ;
          rdfs:comment "A role is the function of an entity or agent with respect to an activity, in the context of a usage, generation, invalidation, association, start, and end."@en ;
          rdfs:isDefinedBy prov: ;
          rdfs:label "Rolle des Akteurs"@de ,
                     "role"@en ;
          skos:editorialNote "changed by m4i: added German labels, added rdfs:label, added rdfs:comment, added German definition, added instances, harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  http://www.w3.org/ns/prov#SoftwareAgent
prov:SoftwareAgent rdf:type owl:Class ;
                   rdfs:subClassOf prov:Agent ;
                   rdfs:comment "A software agent is running software."@en ,
                                "Eine Software als Akteur ist ein Stück laufender Programmcode, der eine Aufgabe in einem Prozess übernimmt."@de ;
                   rdfs:isDefinedBy prov: ;
                   rdfs:label "Software-Akteur"@de ,
                              "software agent"@en ;
                   skos:editorialNote "changed by m4i: added German labels, added rdfs:label, added rdfs:comment, added German definition, added instances"@en .


###  http://xmlns.com/foaf/0.1/Agent
foaf:Agent rdf:type owl:Class ;
           obo:IAO_0000231 obo:IAO_000028 ;
           obo:IAO_0100001 prov:Agent ;
           rdfs:comment "OBSOLETE. An agent (eg. person, group, software or physical artifact)." ;
           owl:deprecated "true"^^xsd:boolean ;
           skos:editorialNote "Deprecated in version 1.3.0: replaced by prov:Agent"@en ,
                              "exchanged foaf:Agent by prov:Agent to fulfill range definition of prov:agent property" .


###  http://xmlns.com/foaf/0.1/Group
foaf:Group rdf:type owl:Class ;
           rdfs:subClassOf foaf:Agent ;
           obo:IAO_0000231 obo:IAO_000028 ;
           obo:IAO_0100001 prov:Organization ;
           rdfs:comment "OBSOLETE. A class of Agents." ;
           owl:deprecated "true"^^xsd:boolean ;
           skos:editorialNote "Deprecated in version 1.3.0: replaced by prov:Organization"@en .


###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class ;
                  rdfs:subClassOf foaf:Agent ;
                  obo:IAO_0000231 obo:IAO_000028 ;
                  obo:IAO_0100001 prov:Organization ;
                  rdfs:comment "OBSOLETE. An organization." ;
                  owl:deprecated "true"^^xsd:boolean ;
                  skos:editorialNote "Deprecated in version 1.3.0: replaced by prov:Organization"@en .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class ;
            rdfs:subClassOf foaf:Agent ;
            obo:IAO_0000231 obo:IAO_000028 ;
            obo:IAO_0100001 prov:Person ;
            rdfs:comment "OBSOLETE. A person." ;
            owl:deprecated "true"^^xsd:boolean ;
            skos:editorialNote "Deprecated in version 1.3.0: replaced by prov:Person"@en .


###  https://ptb.de/si/CoverageInterval
six:CoverageInterval rdf:type owl:Class ;
                     rdfs:subClassOf m4i:UncertaintyDeclaration ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty six:hasCoverageProbability ;
                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty six:hasIntervalMax ;
                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty six:hasIntervalMin ;
                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty six:hasStandardUnc ;
                                       owl:cardinality "1"^^xsd:nonNegativeInteger
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty six:hasDistribution ;
                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                     ] ;
                     obo:IAO_0000231 obo:IAO_000028 ;
                     obo:IAO_0100001 sis:CoverageIntervalMU ;
                     rdfs:comment "OBSOLETE. Structure for stating a probabilistic-symmetric coverage interval for a real uncertainty, to be applied to an six:Real quantity value"@en ;
                     rdfs:label "obsolet Überdeckungsintervall"@de ,
                                "obsolete coverage interval"@en ;
                     owl:deprecated "true"^^xsd:boolean ;
                     skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:CoverageIntervalMU"@en ,
                                        "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://ptb.de/si/ExpandedUnc
six:ExpandedUnc rdf:type owl:Class ;
                rdfs:subClassOf m4i:UncertaintyDeclaration ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty six:hasCoverageFactor ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty six:hasCoverageProbability ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty six:hasUncertainty ;
                                  owl:cardinality "1"^^xsd:nonNegativeInteger
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty six:hasDistribution ;
                                  owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                ] ;
                obo:IAO_0000231 obo:IAO_000028 ;
                obo:IAO_0100001 sis:ExpandedMU ;
                rdfs:comment "OBSOLETE. Structure for stating an expanded measurement, model, or simulation uncertainty, e.g., to be applied to an six:Real quantity value"@en ;
                rdfs:label "obsolet erweiterte Unsicherheit"@de ,
                           "obsolete expanded uncertainty"@en ;
                owl:deprecated "true"^^xsd:boolean ;
                skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:ExpandedMU"@en ,
                                   "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://ptb.de/si/Real
six:Real rdf:type owl:Class ;
         rdfs:subClassOf m4i:NumericalVariable ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty m4i:hasUncertaintyDeclaration ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty m4i:hasNumericalValue ;
                           owl:cardinality "1"^^xsd:nonNegativeInteger
                         ] ;
         obo:IAO_0000231 obo:IAO_000028 ;
         obo:IAO_0100001 sis:Real ;
         rdfs:comment "OBSOLETE. (Real value +- uncertainty) x measurement unit, i.e., a scalar value with a measurement unit and an uncertainty indication"@en ;
         rdfs:label "obsolet Reell"@de ,
                    "obsolete real"@en ;
         owl:deprecated "true"^^xsd:boolean ;
         skos:editorialNote "Deprecated in version 1.4.0: replaced by sis:Real"@en ,
                            "changed by m4i: harmonized spelling to OBO naming conventions (lower case, space separated), added rdfs:label" .


###  https://ptb.de/sis/MeasurementUncertainty
sis:MeasurementUncertainty rdf:type owl:Class .


###  https://ptb.de/sis/Real
sis:Real rdf:type owl:Class .


###  https://schema.org/CreativeWork
schema:CreativeWork rdf:type owl:Class .


###  https://schema.org/Dataset
schema:Dataset rdf:type owl:Class .


###  https://schema.org/Intangible
schema:Intangible rdf:type owl:Class ;
                  rdfs:comment "A utility class that serves as the umbrella for a number of 'intangible' things such as quantities, structured values, etc."@en ;
                  rdfs:label "Ungreifbares"@de ,
                             "intangible"@en ;
                  skos:editorialNote "changed by m4i: added rdfs:label, added German label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  https://schema.org/Project
schema:Project rdf:type owl:Class ;
               rdfs:comment "An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim"@en ,
                            "Ein typischerweise kollektives Unterfangen zum Erreichen eines vorab geplanten Ziels"@de ;
               rdfs:label "Projekt"@de ,
                          "project"@en ;
               skos:editorialNote "changed by m4i: added German definition, added language tag to English definition, shortened definition"@en ,
                                  "changed by m4i: added German label, added language tag to English label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en .


###  https://schema.org/ResearchProject
schema:ResearchProject rdf:type owl:Class ;
                       rdfs:subClassOf schema:Project ;
                       rdfs:comment "A research project"@en ,
                                    "Ein Forschungsprojekt"@de ;
                       rdfs:label "Forschungsprojekt"@de ,
                                  "research project"@en ;
                       skos:editorialNote "changed by m4i: added German definition, added language tag to English definition"@en ,
                                          "changed by m4i: added German label, added language tag to English label"@en ,
                                          "changed by m4i: changed label to \"research project\" (no CamelCase)"@en .


###  https://schema.org/SoftwareApplication
schema:SoftwareApplication rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://w3id.org/nfdi4ing/metadata4ing#ContactPerson
m4i:ContactPerson rdf:type owl:NamedIndividual ,
                           prov:Role ;
                  rdfs:comment "Person with knowledge of how to access, troubleshoot, or otherwise field issues related to the resource"@en ;
                  rdfs:label "Kontaktperson"@de ,
                             "contact person"@en ;
                  rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#contactperson"^^xsd:anyURI ;
                  skos:scopeNote "May also be the \"Point of Contact\" in an organisation that controls access to the resource, if that organisation is different from the Publisher, Distributor, and Data Manager."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#DataCollector
m4i:DataCollector rdf:type owl:NamedIndividual ,
                           prov:Role ;
                  rdfs:comment "Person/institution responsible for finding or gathering/collecting data under the guidelines of the author(s) or Principal Investigator (PI)"@en ;
                  rdfs:label "Datenerfasser*in"@de ,
                             "data collector"@en ;
                  rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#datacollector"^^xsd:anyURI ;
                  skos:scopeNote "May also be used when crediting survey conductors, interviewers, event or condition observers, or persons responsible for monitoring key instrument data."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#DataCurator
m4i:DataCurator rdf:type owl:NamedIndividual ,
                         prov:Role ;
                rdfs:comment "Person tasked with reviewing, enhancing, cleaning, or standardizing metadata and the associated data submitted for storage, use, and maintenance within a data centre or repository"@en ;
                rdfs:label "Datenkurator*in"@de ,
                           "data curator"@en ;
                rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#datacurator"^^xsd:anyURI ;
                skos:scopeNote """While the DataManager is concerned with digital maintenance, the DataCurator's role encompasses quality assurance focused on content and metadata. DataCurator responsibilities include: checking completeness of the submitted dataset against the content as described by the submitter; verifying standard metadata according to the applicable system or schema; adding or verifying specialized metadata to add value and ensure access across disciplines; and determining how the metadata might map to search engines, database products, and automated feeds. Repository managers as well as data librarians working in the repository fall within this category.

Example: https://doi.org/10.20375/0000-000D-1D1F-2"""@en .


###  http://w3id.org/nfdi4ing/metadata4ing#DataManager
m4i:DataManager rdf:type owl:NamedIndividual ,
                         prov:Role ;
                rdfs:comment "Person (or organisation with a staff of data managers, such as a data centre) responsible for maintaining the finished resource"@en ;
                rdfs:label "Datenverwalter*in"@de ,
                           "data manager"@en ;
                rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#datamanager"^^xsd:anyURI ;
                skos:scopeNote """The work done by this person or organisation ensures that the resource is periodically \"refreshed\" in terms of software/hardware support, is kept available or is protected from unauthorized access, is stored in accordance with industry standards, and is handled in accordance with the records management requirements applicable to it.

Example: https://doi.org/10.6073/pasta/41b3ed2e152e1e4c3846e646118208e7"""@en .


###  http://w3id.org/nfdi4ing/metadata4ing#Distributor
m4i:Distributor rdf:type owl:NamedIndividual ,
                         prov:Role ;
                rdfs:comment "Institution tasked with responsibility to generate/disseminate copies of the resource in either electronic or print form"@en ;
                rdfs:label "Anbieter*in"@de ,
                           "distributor"@en ;
                rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#distributor"^^xsd:anyURI ;
                skos:scopeNote "Works stored in more than one archive/repository may credit each as a distributor."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#Editor
m4i:Editor rdf:type owl:NamedIndividual ,
                    prov:Role ;
           rdfs:comment "A person who oversees the details related to the publication format of the resource"@en ;
           rdfs:label "Herausgeber*in"@de ,
                      "editor"@en ;
           rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#editor"^^xsd:anyURI ;
           skos:scopeNote "Note: if the Editor is to be credited in place of multiple creators, the Editor's name may be supplied as Creator, with \"(Ed.)\" appended to the name."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#HostingInstitution
m4i:HostingInstitution rdf:type owl:NamedIndividual ,
                                prov:Role ;
                       rdfs:comment "Typically, the organisation allowing the resource to be available on the internet through the provision of its hardware/software/operating support"@en ;
                       rdfs:label "bereitstellende Institution"@de ,
                                  "hosting institution"@en ;
                       rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#hostinginstitution"^^xsd:anyURI ;
                       skos:scopeNote """This role normally falls on the University, research center or organization where the data center/data repository belongs.

EXAMPLE: Université Grenoble Alpes (UGA)

May also be used for an organisation that stores the data offline-often a data centre if that data centre is not the \"publisher\" of the resource."""@en .


###  http://w3id.org/nfdi4ing/metadata4ing#Other
m4i:Other rdf:type owl:NamedIndividual ,
                   prov:Role ;
          rdfs:comment "Any person or institution making a significant contribution to the development and/or maintenance of the resource, but whose contribution is notadequately described by any of the other values for contributorType"@en ;
          rdfs:label "other person"@en ,
                     "weitere Person"@de ;
          rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#other"^^xsd:anyURI ;
          skos:editorialNote "changed by m4i: added rdfs:label, added German label, harmonized spelling to OBO naming conventions (lower case, space separated)"@en ;
          skos:scopeNote "Could be a photographer, artist, or writer whose contribution helped to publicize the resource (as opposed to creating it), a reviewer of the resource, someone providing administrative services to the author (such as depositing updates into an online repository, analysing usage, etc.), or one of many other roles."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#Producer
m4i:Producer rdf:type owl:NamedIndividual ,
                      prov:Role ;
             rdfs:comment "Typically,a person or organisation responsible for the artistry and form of a media product"@en ;
             rdfs:label "Produzent*in"@de ,
                        "producer"@en ;
             rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#producer"^^xsd:anyURI ;
             skos:scopeNote "In the data industry, this may be a company \"producing\" DVDs that package data for future dissemination by a distributor."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#ProjectLeader
m4i:ProjectLeader rdf:type owl:NamedIndividual ,
                           prov:Role ;
                  rdfs:comment "Person officially designated as head of project team or sub-project team instrumental in the work necessary to development of the resource"@en ;
                  rdfs:label "Projektleiter*in"@de ,
                             "project leader"@en ;
                  rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#projectleader"^^xsd:anyURI ;
                  skos:scopeNote "The Project Leader is not \"removed\" from the work that resulted in the resource; he or she remains intimately involved"@en .


###  http://w3id.org/nfdi4ing/metadata4ing#ProjectManager
m4i:ProjectManager rdf:type owl:NamedIndividual ,
                            prov:Role ;
                   rdfs:comment "Person officially designated as manager of a project. Project may consist of one or many project teams and sub-teams."@en ;
                   rdfs:label "Projektmanager*in"@de ,
                              "project manager"@en ;
                   rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#projectmanager"^^xsd:anyURI ;
                   skos:scopeNote "The manager of a project normally has more administrative responsibility than actual work involvement."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#ProjectMember
m4i:ProjectMember rdf:type owl:NamedIndividual ,
                           prov:Role ;
                  rdfs:comment "Person on the membership list of a designated project/project team"@en ;
                  rdfs:label "Projektmitglied"@de ,
                             "project member"@en ;
                  rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#projectmember"^^xsd:anyURI ;
                  skos:scopeNote "This vocabulary may or may not indicate the quality, quantity, or substance of the person's involvement."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#RegistrationAgency
m4i:RegistrationAgency rdf:type owl:NamedIndividual ,
                                prov:Role ;
                       rdfs:comment "Institution/organisation officially appointed by a Registration Authority to handle specific tasks within a defined area of responsibility"@en ;
                       rdfs:label "Registrierungsstelle"@de ,
                                  "registration agency"@en ;
                       rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#registrationagency"^^xsd:anyURI ;
                       skos:scopeNote "DataCite is a Registration Agency for the International DOI Foundation (IDF). One of DataCite’s tasks is to assign DOI prefixes to the allocating agents who then assign the full, specific character string to data clients, provide metadata back to the DataCite registry, etc."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#RegistrationAuthority
m4i:RegistrationAuthority rdf:type owl:NamedIndividual ,
                                   prov:Role ;
                          rdfs:comment "A standards-setting body from which Registration Agencies obtain official recognition and guidance"@en ;
                          rdfs:label "Registrierungsbehörde"@de ,
                                     "registration authority"@en ;
                          rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#registrationauthority"^^xsd:anyURI ;
                          skos:scopeNote "The IDF serves as the Registration Authority for the International Standards Organisation (ISO) in the area/domain of Digital Object Identifiers."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#RelatedPerson
m4i:RelatedPerson rdf:type owl:NamedIndividual ,
                           prov:Role ;
                  rdfs:comment "A person without a specifically defined role in the development of the resource, but who is someone the author wishes to recognize"@en ;
                  rdfs:label "related person"@en ,
                             "zugehörige Person"@de ;
                  rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#relatedperson"^^xsd:anyURI ;
                  skos:scopeNote "This person could be an author's intellectual mentor, a person providing intellectual leadership in the discipline or subject domain, etc."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#ResearchGroup
m4i:ResearchGroup rdf:type owl:NamedIndividual ,
                           prov:Role ;
                  rdfs:comment "Typically refers to a group of individuals with a lab, department, or divisionthathas a specifically defined focus of activity."@en ;
                  rdfs:label "Forschungsgruppe"@de ,
                             "research group"@en ;
                  rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#researchgroup"^^xsd:anyURI ;
                  skos:scopeNote """May operate at a narrower level of scope; may or may not hold less administrative responsibility than a project team.
Example: Space Research & Planetary Sciences Division of the University of Bern (WP Unibe)
Source: https://doi.org/10.26302/SSHADE/EXPERIMENT_OP_20201104_001"""@en .


###  http://w3id.org/nfdi4ing/metadata4ing#Researcher
m4i:Researcher rdf:type owl:NamedIndividual ,
                        prov:Role ;
               rdfs:comment "A person involved in analysing data or the results of an experiment or formal study. May indicate an intern or assistant to one of the authors who helped with research but who was not so “key” as to be listed as an author."@en ;
               rdfs:label "Forscher*in"@de ,
                          "researcher"@en ;
               rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#researcher"^^xsd:anyURI ;
               skos:scopeNote "Should be a person, not an institution. Note that a person involved in the gathering of data would fall under the contributorType \"DataCollector.\" The researcher may find additional data online and correlate it to the data collected for the experiment or study, for example."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#RightsHolder
m4i:RightsHolder rdf:type owl:NamedIndividual ,
                          prov:Role ;
                 rdfs:comment "Person or institution owning or managing property rights, including intellectual property rights over the resource"@en ;
                 rdfs:label "Rechteinhaber*in"@de ,
                            "rights holder"@en ;
                 rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#rightsholder"^^xsd:anyURI .


###  http://w3id.org/nfdi4ing/metadata4ing#Sponsor
m4i:Sponsor rdf:type owl:NamedIndividual ,
                     prov:Role ;
            rdfs:comment "Person or organisation that issued a contract or under the auspices of which a work has been written, printed, published, developed, etc."@en ;
            rdfs:label "Sponsor*in"@de ,
                       "sponsor"@en ;
            rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#sponsor"^^xsd:anyURI ;
            skos:scopeNote "Includes organisations that provide in-kind support, through donation, provision of people or a facility or instrumentation necessary for the development of the resource, etc."@en .


###  http://w3id.org/nfdi4ing/metadata4ing#Supervisor
m4i:Supervisor rdf:type owl:NamedIndividual ,
                        prov:Role ;
               rdfs:comment "Designated administrator over one or more groups/teams working to produce a resource, or over one or more steps of a development process"@en ;
               rdfs:label "Betreuer*in"@de ,
                          "supervisor"@en ;
               rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#supervisor"^^xsd:anyURI .


###  http://w3id.org/nfdi4ing/metadata4ing#WorkPackageLeader
m4i:WorkPackageLeader rdf:type owl:NamedIndividual ,
                               prov:Role ;
                      rdfs:comment "A Work Package is a recognized data product, not all of which is included in publication. The package, instead, may include notes, discarded documents, etc. The Work Package Leader is responsible for ensuring the comprehensive contents, versioning, and availability of the Work Package during the development of the resource."@en ;
                      rdfs:label "Arbeitspaketleiter*in"@de ,
                                 "work package leader"@en ;
                      rdfs:seeAlso "https://datacite-metadata-schema.readthedocs.io/en/4.7/appendices/appendix-1/contributorType/#workpackageleader"^^xsd:anyURI .
