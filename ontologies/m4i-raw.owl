    dcterms:contributor  orcid:0000-0002-2239-3955 , orcid:0000-0002-8524-0569 , orcid:0000-0002-9826-018X , orcid:0000-0003-0941-5950 , orcid:0009-0007-2881-3125 , orcid:0000-0001-6272-204X , orcid:0000-0002-1489-6501 , orcid:0000-0001-8341-1478 , orcid:0000-0002-9033-5538 , orcid:0000-0002-1019-9151 , orcid:0000-0002-1698-6826 , orcid:0000-0002-2639-1949 , orcid:0000-0002-5031-9170 ;
    dcterms:source       <https://doi.org/10.52825/CoRDI.v1i.271> ,
