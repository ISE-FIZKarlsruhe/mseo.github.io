###  http://purl.obolibrary.org/obo/IAO_0000231
obo:IAO_0000231 rdf:type owl:AnnotationProperty ;
                rdfs:comment "Relates an annotation property to an obsolescence reason. The values of obsolescence reasons come from a list of predefined terms, instances of the class obsolescence reason specification."@en ;
                rdfs:label "has obsolescence reason"@en ,
                           "hat Obsoleszenzgrund"@de ;
                skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en ,
                                   "changed by m4i: copied obo:IAO_0000115 to a rdfs:comment, adjusted wording"@en ;
                skos:scopeNote "Add as annotation triples in the granting ontology"@en .


###  http://purl.obolibrary.org/obo/IAO_0100001
obo:IAO_0100001 rdf:type owl:AnnotationProperty ;
                rdfs:comment "Property relating an obsolete term to another term that can be used as a substitute"@en ;
                rdfs:label "Begriff ersetzt durch"@de ,
                           "term replaced by"@en ;
                skos:editorialNote "changed by m4i: added German labels, added rdfs:label"@en ,
                                   "changed by m4i: copied obo:IAO_0000115 to a rdfs:comment, adjusted wording"@en ;
                skos:scopeNote "Add as annotation triples in the granting ontology"@en .


